---
import VmConsoleView from '../../../../src/ExHyperV.WoW/components/VmConsoleView.astro';
import '../../../../src/ExHyperV.WoW/styles/ui-design.css';
import '../../shells/win11/win11-tokens.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>虚拟机控制台</title>
    <script is:inline>
      (function () {
        var theme = new URLSearchParams(window.location.search).get('theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.style.background = theme === 'light' ? '#F3F3F3' : '#202020';
          document.documentElement.style.colorScheme = theme;
        }
      })();
    </script>
  </head>
  <body class="console-standalone-host">
    <VmConsoleView />

    <script>
      import { createWowClient } from '../../wow/runtime/protocol';
      import { createConsoleController } from '../../../../src/ExHyperV.WoW/scripts/ui-design-console.js';

      let currentTheme = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      let accentHex = '#4CC2FF';
      let vmSnapshot = {
        id: 'vm-1',
        name: 'Windows 11',
        running: true,
        osIcon: 'Windows.svg',
        generation: 2
      };
      let advSnapshot = {
        consoleSupport: true,
        shielding: false,
        consoleClipboard: true,
        consoleAudioOutput: true,
        consoleAudioInput: true
      };
      let availableVms: Array<Record<string, unknown>> = [vmSnapshot];
      let openVmIds = new Set<string>();
      let serverMode: 'demo' | 'live' = 'demo';
      let serverUrl = '';
      let unusedInitialTicket: string | null = null;
      let initialTicketVmId = '';
      let nextRequestSeq = 1;
      const pendingTicketRequests = new Map<
        string,
        {
          resolve: (value: { mode: 'live'; serverUrl: string; ticket: string; protocol?: number; backendId?: string; rights?: string[]; extension?: unknown } | null) => void;
          reject: (reason?: unknown) => void;
          timer: ReturnType<typeof setTimeout>;
        }
      >();
      const pendingPowerRequests = new Map<
        string,
        {
          resolve: (handled: boolean) => void;
          reject: (reason?: unknown) => void;
          timer: ReturnType<typeof setTimeout>;
        }
      >();

      const ctrl = createConsoleController({
        getVm: () => vmSnapshot,
        getAllVms: () => availableVms,
        getAdvSettings: () => advSnapshot,
        getTheme: () => currentTheme,
        getAccentHex: () => accentHex,
        getOpenVmIds: () => openVmIds,
        getServerConnection: async (targetVm: { id?: string } | undefined, mode: string, watchOnly: boolean, ceiling: string[] | null) => {
          if (serverMode !== 'live' || !serverUrl) return null;
          const targetId = String(targetVm?.id || vmSnapshot.id || '');
          if (unusedInitialTicket !== null && (!initialTicketVmId || initialTicketVmId === targetId)) {
            const ticket = unusedInitialTicket;
            unusedInitialTicket = null;
            return { mode: 'live', serverUrl, ticket };
          }
          if (!client.isEmbedded) {
            return { mode: 'live', serverUrl, ticket: '' };
          }
          const requestId = `ticket-${Date.now()}-${nextRequestSeq++}`;
          return new Promise((resolve, reject) => {
            const timer = setTimeout(() => {
              pendingTicketRequests.delete(requestId);
              reject(new Error('向主应用请求控制台连接票据超时'));
            }, 10000);
            pendingTicketRequests.set(requestId, { resolve, reject, timer });
            client
              .request('app.event', {
                channel: 'exhyperv:console-need-ticket',
                payload: { requestId, vmId: targetId, mode, watchOnly, ceiling }
              })
              .catch((err) => {
                clearTimeout(timer);
                pendingTicketRequests.delete(requestId);
                reject(err);
              });
          });
        },
        executeVmPowerAction: async (vmId: string, action: string) => {
          if (serverMode !== 'live') return false;
          if (!client.isEmbedded) return true;
          const requestId = `power-${Date.now()}-${nextRequestSeq++}`;
          return new Promise<boolean>((resolve, reject) => {
            const timer = setTimeout(() => {
              pendingPowerRequests.delete(requestId);
              reject(new Error('等待虚拟机电源操作完成超时'));
            }, 30000);
            pendingPowerRequests.set(requestId, { resolve, reject, timer });
            client
              .request('app.event', {
                channel: 'exhyperv:console-power',
                payload: {
                  id: vmId,
                  action,
                  running: action === 'start' || action === 'restart',
                  requestId
                }
              })
              .catch((err) => {
                clearTimeout(timer);
                pendingPowerRequests.delete(requestId);
                reject(err);
              });
          });
        },
        isHostedInWinOnWeb: true,
        onVmPowerChanged: (changedVm: { id?: string; running?: boolean } | undefined) => {
          if (serverMode === 'live') return;
          const target = changedVm || vmSnapshot;
          if (client.isEmbedded) {
            void client.request('app.event', {
              channel: 'exhyperv:console-power',
              payload: { id: target.id, running: Boolean(target.running) }
            }).catch(() => {});
          }
        },
        onActiveVmChanged: (vmId: string) => {
          if (client.isEmbedded) {
            void client.request('app.event', {
              channel: 'exhyperv:console-active-vm',
              payload: { vmId }
            }).catch(() => {});
          }
        },
        onFocusExistingWindow: (vmId: string) => {
          if (client.isEmbedded) {
            void client.request('app.event', {
              channel: 'exhyperv:console-focus-vm',
              payload: { vmId }
            }).catch(() => {});
          }
        },
        onOpenNewWindow: (tabPayload: Record<string, unknown>) => {
          if (client.isEmbedded) {
            void client.request('app.event', {
              channel: 'exhyperv:console-new-window',
              payload: {
                ...tabPayload,
                availableVms,
                serverMode,
                serverUrl,
                wsTicket: ''
              }
            }).catch(() => {});
          }
        },
        onDragSpacerRect: (rect: { left: number; width: number }) => {
          if (client.isEmbedded) {
            void client.request('app.event', {
              channel: 'exhyperv:console-drag-rect',
              payload: rect
            }).catch(() => {});
          }
        },
        onRequestClose: () => {
          if (client.isEmbedded) {
            void client.windowControl('close').catch(() => {});
          }
        }
      });

      function applyTheme(nextTheme: string) {
        currentTheme = nextTheme === 'light' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', currentTheme);
        document.documentElement.style.background = currentTheme === 'light' ? '#F3F3F3' : '#202020';
        document.documentElement.style.colorScheme = currentTheme;
        if (document.body) {
          document.body.style.background = currentTheme === 'light' ? '#F3F3F3' : '#202020';
        }
        ctrl.syncTheme();
      }

      function applyLaunchPayload(raw: Record<string, unknown> | undefined) {
        if (!raw || typeof raw !== 'object') return;
        const nextVm: Record<string, unknown> = { ...vmSnapshot };
        if (typeof raw.id === 'string') nextVm.id = raw.id;
        if (typeof raw.name === 'string') nextVm.name = raw.name;
        if (typeof raw.running === 'boolean') nextVm.running = raw.running;
        if (typeof raw.osIcon === 'string') nextVm.osIcon = raw.osIcon;
        if (typeof raw.generation === 'number') nextVm.generation = raw.generation;
        if (typeof raw.mode === 'string') nextVm.mode = raw.mode;
        if (typeof raw.scaleMode === 'string') nextVm.scaleMode = raw.scaleMode;
        if (typeof raw.desktopScale === 'number') nextVm.desktopScale = raw.desktopScale;
        if (typeof raw.resolution === 'string') nextVm.resolution = raw.resolution;
        if (typeof raw.clipboardEnabled === 'boolean') nextVm.clipboardEnabled = raw.clipboardEnabled;
        if (typeof raw.serverMode === 'string') {
          serverMode = raw.serverMode === 'live' ? 'live' : 'demo';
          nextVm.serverMode = serverMode;
          if (serverMode === 'demo') {
            serverUrl = '';
            unusedInitialTicket = null;
          }
        }
        if (typeof raw.serverUrl === 'string') {
          serverUrl = raw.serverUrl;
          nextVm.serverUrl = serverUrl;
        }
        if (typeof raw.wsTicket === 'string') {
          unusedInitialTicket = raw.wsTicket ? raw.wsTicket : null;
          initialTicketVmId = typeof raw.id === 'string' ? raw.id : String(nextVm.id || '');
          nextVm.wsTicket = raw.wsTicket;
        } else if (serverMode === 'live' && raw.serverMode === 'live' && raw.wsTicket === '') {
          unusedInitialTicket = null;
        }
        vmSnapshot = nextVm as typeof vmSnapshot;

        const nextAdv = { ...advSnapshot };
        if (typeof raw.consoleSupport === 'boolean') nextAdv.consoleSupport = raw.consoleSupport;
        if (typeof raw.shielding === 'boolean') nextAdv.shielding = raw.shielding;
        if (typeof raw.consoleClipboard === 'boolean') nextAdv.consoleClipboard = raw.consoleClipboard;
        if (typeof raw.consoleAudioOutput === 'boolean') nextAdv.consoleAudioOutput = raw.consoleAudioOutput;
        if (typeof raw.consoleAudioInput === 'boolean') nextAdv.consoleAudioInput = raw.consoleAudioInput;
        advSnapshot = nextAdv;

        if (Array.isArray(raw.availableVms) && raw.availableVms.length > 0) {
          availableVms = raw.availableVms as Array<Record<string, unknown>>;
        }
        if (typeof raw.accentHex === 'string') accentHex = raw.accentHex;
        document.title = `${vmSnapshot.name} - 控制台`;
      }

      const client = createWowClient({
        onInit: (info) => {
          applyTheme(info.theme);
          applyLaunchPayload(info.launchArgs);
          ctrl.openTab(vmSnapshot, advSnapshot);
        },
        onThemeChange: applyTheme,
        onEvent: (name, value) => {
          if (name === 'message' && value && typeof value === 'object') {
            const msg = value as { channel?: string; payload?: Record<string, unknown> };
            if ((msg.channel === 'exhyperv:console-add-tab' || msg.channel === 'exhyperv:console-sync') && msg.payload) {
              applyLaunchPayload(msg.payload);
              ctrl.openTab(vmSnapshot, advSnapshot);
            } else if (msg.channel === 'exhyperv:console-ticket-reply' && msg.payload) {
              const reqId = typeof msg.payload.requestId === 'string' ? msg.payload.requestId : '';
              const pending = pendingTicketRequests.get(reqId);
              if (pending) {
                clearTimeout(pending.timer);
                pendingTicketRequests.delete(reqId);
                if (msg.payload.serverMode === 'live' && typeof msg.payload.serverUrl === 'string' && msg.payload.serverUrl) {
                  serverMode = 'live';
                  serverUrl = msg.payload.serverUrl;
                  pending.resolve({
                    mode: 'live',
                    serverUrl,
                    protocol: Number(msg.payload.protocol) || 1, rights: msg.payload.rights as string[] | undefined, backendId: String(msg.payload.backendId || ''), extension: msg.payload.extension,
                    ticket: typeof msg.payload.wsTicket === 'string' ? msg.payload.wsTicket : ''
                  });
                } else if (msg.payload.serverMode === 'demo') {
                  serverMode = 'demo';
                  serverUrl = '';
                  pending.resolve(null);
                } else {
                  pending.reject(new Error(typeof msg.payload.error === 'string' ? msg.payload.error : '获取控制台连接票据失败'));
                }
              }
            } else if (msg.channel === 'exhyperv:console-power-reply' && msg.payload) {
              const reqId = typeof msg.payload.requestId === 'string' ? msg.payload.requestId : '';
              const pending = pendingPowerRequests.get(reqId);
              if (pending) {
                clearTimeout(pending.timer);
                pendingPowerRequests.delete(reqId);
                if (msg.payload.ok === false) {
                  pending.reject(new Error(typeof msg.payload.error === 'string' ? msg.payload.error : '虚拟机电源操作失败'));
                } else {
                  pending.resolve(msg.payload.mode !== 'demo');
                }
              }
            } else if (msg.channel === 'exhyperv:console-open-vms' && msg.payload && Array.isArray(msg.payload.vmIds)) {
              openVmIds = new Set(msg.payload.vmIds.filter((id): id is string => typeof id === 'string'));
            } else if (msg.channel === 'exhyperv:console-focus-self') {
              if (client.isEmbedded) void client.windowControl('focus').catch(() => {});
            }
          }
        }
      });

      window.addEventListener(
        'pointerdown',
        () => {
          if (client.isEmbedded) void client.windowControl('focus').catch(() => {});
        },
        { passive: true },
      );

      window.addEventListener(
        'contextmenu',
        (e) => {
          const target = e.target;
          if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) return;
          e.preventDefault();
        },
        { capture: true },
      );

      if (!client.isEmbedded) {
        ctrl.openTab(vmSnapshot, advSnapshot);
      } else {
        window.addEventListener('pagehide', () => {
          void client.request('app.event', { channel: 'exhyperv:console-closed', payload: {} }).catch(() => {});
        });
      }
    </script>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      [hidden] {
        display: none !important;
      }

      html,
      body.console-standalone-host {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #202020;
        font-family: var(--win-font-sans);
        font-size: 14px;
      }

      body.console-standalone-host .vm-console-window {
        position: fixed !important;
        inset: 0 !important;
        top: 0 !important;
        left: 0 !important;
        transform: none !important;
        width: 100% !important;
        height: 100% !important;
        min-width: 0 !important;
        min-height: 0 !important;
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        grid-template-rows: 40px 1fr !important;
      }

      body.console-standalone-host .vm-console-window.is-fullscreen {
        grid-template-rows: 1fr !important;
      }

      /* WinOnWeb seamlessTitlebar provides top-right window caption buttons */
      body.console-standalone-host .console-titlebar {
        padding-right: 138px;
        cursor: default;
      }

      body.console-standalone-host .console-titlebar .caption-buttons {
        display: none !important;
      }

      html[data-theme='light'],
      html[data-theme='light'] body.console-standalone-host {
        background: #F3F3F3;
      }
    </style>
  </body>
</html>
