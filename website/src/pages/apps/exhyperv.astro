---
import WinUiWorkbench from '../../../../src/ExHyperV.WoW/components/WinUiWorkbench.astro';
import '../../shells/win11/win11-tokens.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ExHyperV</title>
    <script is:inline>
      (function () {
        document.documentElement.classList.add('winui-hydrating');
        var theme = new URLSearchParams(window.location.search).get('theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.style.background = theme === 'light' ? '#F3F3F3' : '#202020';
          document.documentElement.style.colorScheme = theme;
        }
        window.setTimeout(function () {
          document.documentElement.classList.remove('winui-hydrating');
        }, 2500);
      })();
    </script>
  </head>
  <body>
    <WinUiWorkbench />

    <script>
      import { createWowClient } from '../../wow/runtime/protocol';

      function applyTheme(nextTheme: string) {
        const normalized = nextTheme === 'light' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', normalized);
        document.documentElement.style.background = normalized === 'light' ? '#F3F3F3' : '#202020';
        if (document.body) {
          document.body.style.background = normalized === 'light' ? '#F3F3F3' : '#202020';
        }
        const winEl = document.getElementById('winuiWindow');
        if (winEl) {
          winEl.setAttribute('data-theme', normalized);
        }
        document.documentElement.style.colorScheme = normalized;
        const picker = document.getElementById('settingsThemePicker') as HTMLSelectElement | null;
        if (picker && picker.value !== normalized) {
          picker.value = normalized;
          picker.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }

      function publishVirtualHardware(hw: unknown) {
        if (!hw || typeof hw !== 'object') return;
        (window as unknown as Record<string, unknown>).__WIN11_HARDWARE__ = hw;
        window.dispatchEvent(new CustomEvent('win11:hardware', { detail: hw }));
      }

      const client = createWowClient({
        onInit: (info) => {
          applyTheme(info.theme);
          (window as unknown as Record<string, unknown>).__WOW_APP_READY__ = true;
          window.dispatchEvent(new CustomEvent('exhyperv:wow-init', { detail: info }));
          void client.getHwSnapshot().then(publishVirtualHardware).catch(() => {});
        },
        onThemeChange: applyTheme,
        onEvent: (name, value) => {
          if (name === 'hardware') {
            publishVirtualHardware(value);
          } else if (name === 'message' && value && typeof value === 'object') {
            window.dispatchEvent(new CustomEvent('exhyperv:wow-message', { detail: value }));
          }
        },
      });

      (window as unknown as Record<string, unknown>).__WOW_APP_CLIENT__ = {
        emitAppEvent: (channel: string, payload?: unknown) => {
          if (!client.isEmbedded) return;
          void client.request('app.event', { channel, payload }).catch(() => {});
        },
      };

      window.addEventListener(
        'pointerdown',
        () => {
          if (client.isEmbedded) void client.windowControl('focus').catch(() => {});
        },
        { passive: true },
      );

      window.addEventListener(
        'contextmenu',
        (e) => {
          const target = e.target;
          if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) return;
          e.preventDefault();
        },
        { capture: true },
      );
    </script>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      [hidden] {
        display: none !important;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #202020;
        font-family: var(--win-font-sans);
        font-size: 14px;
        -webkit-touch-callout: none;
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      button {
        color: inherit;
        cursor: pointer;
      }

      /* 嵌入桌面窗口时剥离官网页面外边距、独立标题栏与设计调参面板 */
      .ui-workbench-page {
        width: 100% !important;
        height: 100% !important;
        min-height: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
        display: block !important;
      }

      .winui-window {
        width: 100% !important;
        height: 100% !important;
        min-width: 0 !important;
        min-height: 0 !important;
        max-width: none !important;
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        transform: none !important;
        grid-template-rows: minmax(0, 1fr) !important;
        z-index: 1 !important;
      }

      .winui-navview {
        height: 100% !important;
        border-radius: 0 !important;
      }

      .winui-titlebar,
      .win-resize-handle,
      .design-candidates-panel {
        display: none !important;
      }

      html[data-theme='light'],
      html[data-theme='light'] body {
        background: #F3F3F3;
      }

      html.winui-hydrating .winui-window {
        opacity: 0 !important;
        pointer-events: none !important;
      }
    </style>
  </body>
</html>
