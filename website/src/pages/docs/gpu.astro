---
import SiteLayout from '../../layouts/SiteLayout.astro';
import data from '../../data/gpu-pv-driver-requirements.json';
import '../../styles/gpu-docs.css';

const pageTitle = 'GPU-PV 显卡驱动要求';
const vendorResearchRoute = {
  nvidia: '/docs/gpu-driver-research/nvidia/',
  intel: '/docs/gpu-driver-research/intel/',
  amd: '/docs/gpu-driver-research/amd/',
  qualcomm: '/docs/gpu-driver-research/qualcomm/',
};
const lineKeyByRowId: Record<string, string> = {
  'intel-core-igpu': 'gpuLineIntelCore',
  'intel-arc': 'gpuLineIntelArc',
  'qualcomm-adreno': 'gpuLineQualcomm',
};
const noteKeyByRowId: Record<string, string> = {
  'nvidia-geforce': 'gpuNoteNvidiaCuda',
  'nvidia-studio': 'gpuNoteNvidiaCuda',
  'nvidia-quadro': 'gpuNoteNvidiaWddmCuda',
  'nvidia-tesla': 'gpuNoteNvidiaWddmCuda',
  'intel-core-igpu': 'gpuNoteIntelCore',
  'amd-radeon': 'gpuNoteAmdRocm',
  'amd-radeon-pro': 'gpuNoteAmdRocm',
  'qualcomm-adreno': 'gpuNoteQualcomm',
};
const tierKeyByName: Record<string, string> = {
  'X 系列': 'gpuTierXSeries',
};
---
<SiteLayout module="docs" title={pageTitle}>
  <article class="doc-page doc-page--narrow" data-docs-gpu data-docs-filter-root>
    <nav class="doc-crumb" aria-label="页面路径" data-i18n-aria="breadcrumb">
      <a href="/docs/" data-i18n="docs">文档</a>
      <span aria-hidden="true">/</span>
      <span data-i18n="gpuDocsCrumb">显卡驱动要求</span>
    </nav>

    <header class="doc-header">
      <h1 data-i18n="gpuDocs">{pageTitle}</h1>
      <p class="doc-lead" data-i18n="gpuLeadUpdate">建议直接将宿主机 Windows 与显卡驱动更新到官方最新正式版。</p>
      <p class="doc-lead">
        <span data-i18n="gpuLeadThreshold">下表为各系列已知最早支持门槛，不等同于达到该版本即保证稳定。</span>
        <a class="doc-link doc-lead-link" href="/docs/gpu-driver-research/" data-i18n="gpuResearchLink">查看驱动研究档案 →</a>
      </p>
    </header>

    <div class="doc-tabs" role="group" aria-label="按厂商筛选" data-i18n-aria="filterByVendor">
      <button type="button" class="doc-tab" data-filter-group="vendor" data-filter-value="all" aria-pressed="true" data-i18n="filterAll">全部</button>
      {data.vendors.map((vendor) => (
        <button type="button" class="doc-tab" data-filter-group="vendor" data-filter-value={vendor.id} aria-pressed="false">{vendor.name}</button>
      ))}
    </div>

    <div class="doc-table-wrap">
      <table class="doc-table">
        <thead>
          <tr>
            <th data-i18n="gpuColSeries">显卡系列</th>
            <th data-i18n="gpuColWindows">Windows 虚拟机</th>
            <th data-i18n="gpuColLinux">Linux 虚拟机</th>
            <th data-i18n="gpuColNotes">说明</th>
          </tr>
        </thead>
        <tbody>
          {data.rows.map((row) => (
            <tr data-filter-item data-filter-vendor={row.vendor}>
              <td>
                <a class="doc-row-link" href={`${vendorResearchRoute[row.vendor]}#${row.research_anchor}`} data-i18n={lineKeyByRowId[row.id]}>{row.driver_line}</a>
              </td>
              <td>
                {row.tiers.length > 0 ? (
                  <div class="doc-tiers">
                    {row.tiers.map((tier) => (
                      <div class="doc-tier">
                        <span class="doc-tier-name" data-i18n={tierKeyByName[tier.name]}>{tier.name}</span>
                        {tier.windows_min_version === '—'
                          ? <span class="doc-muted">—</span>
                          : <code>{tier.windows_min_version}</code>}
                      </div>
                    ))}
                  </div>
                ) : row.windows_min_version === '—' ? (
                  <span class="doc-muted">—</span>
                ) : (
                  <code>{row.windows_min_version}</code>
                )}
              </td>
              <td>
                {row.tiers.length > 0 ? (
                  <div class="doc-tiers">
                    {row.tiers.map((tier) => (
                      <div class="doc-tier">
                        <span class="doc-tier-name" data-i18n={tierKeyByName[tier.name]}>{tier.name}</span>
                        {tier.linux_min_version === '—'
                          ? <span class="doc-muted">—</span>
                          : <code>{tier.linux_min_version}</code>}
                      </div>
                    ))}
                  </div>
                ) : row.linux_min_version === '—' ? (
                  <span class="doc-muted">—</span>
                ) : (
                  <code>{row.linux_min_version}</code>
                )}
              </td>
              <td data-i18n={row.notes ? noteKeyByRowId[row.id] : undefined}>{row.notes || <span class="doc-muted">—</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </article>

  <script>import '../../scripts/docs-filter.js';</script>
</SiteLayout>
