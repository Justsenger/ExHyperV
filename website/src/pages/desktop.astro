---
import '../win11-shell/win11-tokens.css';
import '../styles/brand.css';
import Topbar from '../components/Topbar.astro';
import Win11Desktop from '../win11-shell/Win11Desktop.astro';
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="stylesheet" href="/typefaces/resource-rounded.css" />
    <title>Windows 11 桌面体验 | ExHyperV</title>
    <link rel="preload" as="image" href="/win11/wallpapers/bloom-dark.webp" />
  </head>
  <body data-module="uiDesign">
    <Topbar module="uiDesign" />
    <Win11Desktop />
    <script>
      import { initializeLocalization } from '../scripts/localization.js';
      initializeLocalization();
    </script>
  </body>
</html>

<style is:global>
  [hidden] {
    display: none !important;
  }

  body[data-module="uiDesign"] {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--win-bg-fallback, #050b19);
  }

  .ex-top {
    position: fixed;
    inset: 0 0 auto;
    height: 68px;
    width: 100%;
    z-index: 9600;
    font-family: 'ExHyperV Brand', 'ExHyperV Resource Rounded CN', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 600;
  }

  .ex-top a {
    color: inherit;
    text-decoration: none;
  }

  .ex-top svg {
    display: block;
    fill: currentColor;
    flex-shrink: 0;
  }

  .nav-wrapper {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 100%;
    padding: 0 20px;
    gap: 24px;
  }

  .topbar-links {
    grid-column: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 35px;
    height: 100%;
  }

  .topbar-links a {
    display: flex;
    align-items: center;
    height: 100%;
    font-size: 16px;
    color: #b8b8bf;
    white-space: nowrap;
    transition: color .15s;
  }

  .topbar-links a:hover,
  .topbar-links a[aria-current="page"] {
    color: #fff;
  }

  .topbar-actions {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ex-top a:focus-visible,
  .ex-top button:focus-visible {
    outline: 2px solid #a7a7b0;
    outline-offset: 5px;
  }

  @media (max-width: 640px) {
    .ex-top {
      height: 56px;
    }
  }
</style>
