        rgba(14, 72, 160, 0.07) 26%,
        rgba(8, 36, 92, 0.025) 52%,
        transparent 76%
      );
    }
  }
  home-model img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
    position: relative;
    z-index: 1;
  }
  home-model :global(canvas) {
