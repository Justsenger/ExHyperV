<home-model role="group" tabindex="0" aria-label="ExHyperV 三维图标，拖拽或使用方向键旋转，双击复位" data-i18n-aria="rotateModel">
  <img src="/images/home-model-poster.webp" width="640" height="640" alt="ExHyperV" draggable="false" fetchpriority="high" />
</home-model>

<script>
  import '../scripts/home-model.js';
