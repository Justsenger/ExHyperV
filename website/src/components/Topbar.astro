---
const { module } = Astro.props;
const links = [ ['home', '首页', '/'], ['wiki', '系统图鉴', '/os/'], ['docs', '文档', '/docs/'] ];
---
<header class="ex-top"><nav aria-label="主站导航" data-i18n-aria="navigation"><div class="nav-wrapper">
  <a class="site-brand" href="/"><span class="brand-text">ExHyperV</span></a>
  <div class="topbar-links">{links.map(([key, label, href]) => <a href={href} data-module={key} data-i18n={key} aria-current={module === key ? 'page' : undefined}>{label}</a>)}</div>
  <div class="topbar-actions">
    <select class="site-language" data-site-language aria-label="语言" data-i18n-aria="language" hidden>
      <option value="auto" data-i18n="automatic">自动</option>
      <option value="zh-CN">简体中文</option>
      <option value="zh-TW">繁體中文</option>
      <option value="en">English</option>
    </select>
    {module === 'wiki' && <button id="sidebar-toggle" class="sidenav-trigger" aria-label="展开分类" data-i18n-aria="expandCategories" aria-controls="slide-out" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg></button>}
  </div>
</div></nav></header>
