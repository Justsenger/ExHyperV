---
import { ClientRouter } from 'astro:transitions';
import Topbar from '../components/Topbar.astro';
import Sidebar from '../components/Sidebar.astro';
import '../styles/site.css';
import '../styles/brand.css';
const { module = 'wiki', selectedId = '', navigationId = selectedId, title = '系统图鉴', family = '', branch = '' } = Astro.props;
const isWiki = module === 'wiki';
---
<!doctype html><html lang="zh-CN"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#f6faff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#111822" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
  <link rel="stylesheet" href="/typefaces/resource-rounded.css" />
  <title>{module === 'home' ? 'ExHyperV' : `${title} | ExHyperV${selectedId ? ' 系统图鉴' : ''}`}</title>
  <script is:inline>
    (() => {
      try {
        const normalize = (value) => {
          const raw = String(value || 'und').trim().replaceAll('_', '-');
          const alias = { cn: 'zh-CN', sc: 'zh-CN', chs: 'zh-CN', cht: 'zh-TW', 'zh-hans': 'zh-CN', 'zh-hant': 'zh-TW', zh: 'zh-CN' };
          if (alias[raw.toLowerCase()]) return alias[raw.toLowerCase()];
          try { return Intl.getCanonicalLocales(raw)[0] || 'und'; } catch { return 'und'; }
        };
        const saved = localStorage.getItem('exhyperv.language');
        const pref = saved === 'zh-CN' || saved === 'zh-TW' || saved === 'en' ? saved : 'auto';
        const lang = pref !== 'auto'
          ? pref
          : ((navigator.languages || [navigator.language]).map(normalize).find((item) => item !== 'und') || 'zh-CN');
        const ui = lang.startsWith('zh') ? (/TW|HK|Hant/.test(lang) ? 'zh-TW' : 'zh-CN') : 'en';
        document.documentElement.lang = ui;
        document.documentElement.dataset.uiLang = ui;
        if (ui !== 'zh-CN') {
          document.documentElement.classList.add('i18n-pending');
          setTimeout(() => document.documentElement.classList.remove('i18n-pending'), 250);
        }
      } catch {}
    })();
  </script>
  <style is:inline>html.i18n-pending header.ex-top,html.i18n-pending main{opacity:0}</style>
  <ClientRouter />
</head><body class:list={[{ 'module-empty': !isWiki }]} data-module={module} data-page-title={title} transition:animate="none">
  <Topbar module={module} />
  {isWiki && <Sidebar selectedId={navigationId} />}
  {isWiki && <button class="wiki-backdrop" id="wiki-backdrop" aria-label="关闭分类" data-i18n-aria="closeCategories" hidden />}
  <main id="wiki-content" data-version={selectedId} data-navigation-version={navigationId} data-family={family} data-branch={branch} aria-label={`${title}${selectedId ? ' ' : ''}内容`}><slot /></main>
  <div id="full-name-popup" class="full-name-popup" role="tooltip" hidden></div>
  <script>import '../scripts/site.js';</script>
</body></html>
