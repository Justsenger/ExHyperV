---
import './task-manager.css';
import { getAppIconSvg, UI_ICONS } from './icons';

const { showCandidatesPanel = true } = Astro.props;
---

<div class="w11-shell" data-win11-root>
  <!-- 真实 Windows 11 Bloom 壁纸与环境滤镜层 -->
  <div class="w11-wallpaper" data-wallpaper style="background-image: url('/win11/wallpapers/bloom-dark.webp');"></div>
  <div class="w11-overlay w11-overlay--brightness" data-brightness-overlay></div>
  <div class="w11-overlay w11-overlay--nightlight" data-nightlight-overlay></div>

  <!-- 桌面区域（图标网格 + 框选矩形） -->
  <main class="w11-desktop-area" data-desktop-area>
    <div class="w11-desktop-icons" data-icons-layer></div>
    <div class="w11-marquee" data-marquee></div>
  </main>

  <!-- 窗口贴靠预览与窗口管理层 -->
  <div class="w11-snap-preview" data-snap-preview></div>
  <div class="w11-windows-layer" data-windows-layer></div>

  <!-- 开始菜单 -->
  <section class="w11-flyout w11-start-menu" data-start-menu aria-label="开始菜单">
    <div class="w11-start-search-wrap">
      <span class="w11-start-search-icon" set:html={UI_ICONS.searchSmall} />
      <input
        type="text"
        class="w11-start-search"
        data-start-search
        placeholder="搜索应用、设置和文档"
        autocomplete="off"
      />
    </div>
    <div class="w11-start-section-head">
      <span>已固定</span>
    </div>
    <div class="w11-start-grid" data-start-grid></div>
    <footer class="w11-start-footer">
      <div class="w11-start-user">
        <span class="w11-start-avatar" set:html={UI_ICONS.user} />
        <span>admin</span>
      </div>
      <div class="w11-start-power-wrap">
        <button type="button" class="w11-icon-btn" data-start-power aria-haspopup="menu" aria-expanded="false" title="电源选项">
          <span set:html={UI_ICONS.power} />
        </button>
        <div class="w11-power-popover" data-start-power-menu hidden role="menu">
          <button type="button" class="w11-power-item" data-power-action="lock" role="menuitem">锁定</button>
          <button type="button" class="w11-power-item" data-power-action="signout" role="menuitem">注销</button>
          <button type="button" class="w11-power-item" data-power-action="restart" role="menuitem">重启</button>
          <div class="w11-power-divider"></div>
          <button type="button" class="w11-power-item" data-power-action="reset-layout" role="menuitem">重置桌面布局</button>
        </div>
      </div>
    </footer>
  </section>

  <!-- 快速设置面板 -->
  <section class="w11-flyout w11-quick-settings" data-quick-settings aria-label="快速设置">
    <div class="w11-qs-body">
      <div class="w11-qs-grid">
        <div class="w11-qs-cell">
          <button type="button" class="w11-qs-tile" data-qs-toggle="wifi" aria-label="WLAN">
            <span class="w11-qs-tile__icon" set:html={UI_ICONS.wifi} />
          </button>
          <span class="w11-qs-tile__label">WLAN</span>
        </div>
        <div class="w11-qs-cell">
          <button type="button" class="w11-qs-tile" data-qs-toggle="bluetooth" aria-label="蓝牙">
            <span class="w11-qs-tile__icon" set:html={UI_ICONS.bluetooth} />
          </button>
          <span class="w11-qs-tile__label">蓝牙</span>
        </div>
        <div class="w11-qs-cell">
          <button type="button" class="w11-qs-tile" data-qs-toggle="airplane" aria-label="飞行模式">
            <span class="w11-qs-tile__icon" set:html={UI_ICONS.airplane} />
          </button>
          <span class="w11-qs-tile__label">飞行模式</span>
        </div>
        <div class="w11-qs-cell">
          <button type="button" class="w11-qs-tile" data-qs-toggle="theme" aria-label="深色外观">
            <span class="w11-qs-tile__icon" set:html={UI_ICONS.moon} />
          </button>
          <span class="w11-qs-tile__label">深色外观</span>
        </div>
        <div class="w11-qs-cell">
          <button type="button" class="w11-qs-tile" data-qs-toggle="nightLight" aria-label="夜间模式">
            <span class="w11-qs-tile__icon" set:html={UI_ICONS.brightness} />
          </button>
          <span class="w11-qs-tile__label">夜间模式</span>
        </div>
      </div>
      <div class="w11-qs-sliders">
        <label class="w11-qs-slider-row">
          <span class="w11-qs-slider-icon" set:html={UI_ICONS.brightness} />
          <input type="range" min="35" max="100" value="100" data-qs-brightness aria-label="屏幕亮度" />
        </label>
        <label class="w11-qs-slider-row">
          <span class="w11-qs-slider-icon" set:html={UI_ICONS.volume} />
          <input type="range" min="0" max="100" value="65" data-qs-volume aria-label="系统音量" />
        </label>
      </div>
    </div>
    <footer class="w11-qs-footer">
      <span class="w11-qs-battery">
        <span set:html={UI_ICONS.battery} />
        <span>92%</span>
      </span>
      <button type="button" class="w11-icon-btn" data-qs-open-settings title="所有设置">
        <span set:html={getAppIconSvg('settings', 16)} />
      </button>
    </footer>
  </section>

  <!-- 日历浮层 -->
  <section class="w11-flyout w11-calendar-flyout" data-calendar-flyout aria-label="日期与日历"></section>

  <!-- 托盘折叠浮层 -->
  <section class="w11-flyout w11-tray-overflow" data-tray-overflow aria-label="隐藏的托盘图标">
    <div class="w11-tray-overflow__item" title="Windows 安全中心">
      <span set:html={getAppIconSvg('start', 16)} />
    </div>
    <div class="w11-tray-overflow__item" title="任务管理器">
      <span set:html={getAppIconSvg('task-manager', 16)} />
    </div>
  </section>

  <!-- 全局右键菜单 -->
  <div class="w11-context-menu" data-context-menu></div>

  <!-- 右侧浮动设计候选菜单（与 ExHyperV 设备·显卡同步） -->
  {showCandidatesPanel && (
  <aside class="w11-dcp-panel" id="desktopCandidatesPanel" aria-label="显卡设计候选菜单">
    <div class="w11-dcp-header" id="desktopDcpHeader">
      <span class="w11-dcp-title">显卡界面候选</span>
      <button type="button" class="w11-dcp-toggle" id="desktopDcpCollapseBtn" title="收起/展开候选菜单">−</button>
    </div>
    <div class="w11-dcp-body" id="desktopDcpBody">
      <div class="w11-dcp-subhead">布局方案（多设备统一）</div>
      <div class="w11-dcp-list">
        <button class="w11-dcp-chip active" data-dcp-gpu-variant="expander" type="button">A · 经典 Expander</button>
        <button class="w11-dcp-chip" data-dcp-gpu-variant="tiles" type="button">B · 干净 KV 瓦片</button>
        <button class="w11-dcp-chip" data-dcp-gpu-variant="compact" type="button">C · 紧凑多设备行</button>
        <button class="w11-dcp-chip" data-dcp-gpu-variant="layered" type="button">D · 主卡 + 折叠策略</button>
      </div>
      <div class="w11-dcp-subhead">数据与异常状态</div>
      <div class="w11-dcp-list">
        <button class="w11-dcp-chip active" data-dcp-gpu-status="single" type="button">单卡（RTX 4090）</button>
        <button class="w11-dcp-chip" data-dcp-gpu-status="dual" type="button">双卡（4090 + 核显）</button>
        <button class="w11-dcp-chip" data-dcp-gpu-status="empty" type="button">未分配（空状态）</button>
        <button class="w11-dcp-chip" data-dcp-gpu-status="stale" type="button">路径失效（需重绑）</button>
        <button class="w11-dcp-chip" data-dcp-gpu-status="mmio-pending" type="button">MMIO 待优化</button>
      </div>
      <div class="w11-dcp-subhead">页面视图</div>
      <div class="w11-dcp-list">
        <button class="w11-dcp-chip active" data-dcp-gpu-mode="list" type="button">显卡列表主视图</button>
        <button class="w11-dcp-chip" data-dcp-gpu-mode="select" type="button">选择宿主显卡</button>
        <button class="w11-dcp-chip" data-dcp-gpu-mode="deploy" type="button">驱动部署流程</button>
      </div>
    </div>
  </aside>
  )}

  <!-- 底部任务栏 -->
  <footer class="w11-taskbar" data-taskbar>
    <div class="w11-taskbar-left"></div>
    <div class="w11-taskbar-center">
      <button type="button" class="w11-tb-item w11-tb-start" data-taskbar-start title="开始">
        <span class="w11-tb-glyph" set:html={getAppIconSvg('start', 24)} />
      </button>
      <button type="button" class="w11-tb-search-pill" data-taskbar-search title="搜索">
        <span class="w11-tb-search-icon" set:html={UI_ICONS.searchSmall} />
        <span>搜索</span>
      </button>
      <div class="w11-taskbar-apps" data-taskbar-apps></div>
    </div>
    <div class="w11-taskbar-tray">
      <button type="button" class="w11-tray-btn" data-taskbar-overflow title="显示隐藏的图标">
        <span set:html={UI_ICONS.chevronUp} />
      </button>
      <button type="button" class="w11-tray-btn w11-tray-ime" data-ime-btn title="切换输入法">中</button>
      <button type="button" class="w11-tray-btn w11-tray-quick" data-taskbar-quick title="网络、音量与电池">
        <span set:html={UI_ICONS.wifi} />
        <span set:html={UI_ICONS.volume} />
        <span set:html={UI_ICONS.battery} />
      </button>
      <button type="button" class="w11-tray-btn w11-tray-clock" data-taskbar-clock title="日期与时间">
        <span class="w11-clock-time" data-clock-time>20:00</span>
        <span class="w11-clock-date" data-clock-date>2026/11/15</span>
      </button>
      <button type="button" class="w11-show-desktop" data-show-desktop title="显示桌面" aria-label="显示桌面"></button>
    </div>
  </footer>

  <!-- Windows 11 锁屏与登录界面（1:1 复刻 MOBAN11 Bloom 锁屏 / admin 登录 / 欢迎页） -->
  <section class="w11-lockscreen is-hidden" data-lock-screen aria-label="Windows 登录屏幕">
    <div class="w11-lock-bg" style="background-image: url('/win11/wallpapers/bloom-dark.webp');"></div>
    <div class="w11-lock-blur-veil"></div>

    <!-- Phase 1: 锁屏时钟界面 -->
    <div class="w11-lock-curtain" data-lock-curtain>
      <div class="w11-lock-clock-box">
        <div class="w11-lock-time" data-lock-time>9:11</div>
        <div class="w11-lock-date" data-lock-date>11月17日, 星期二</div>
      </div>
      <div class="w11-lock-hint">单击或按任意键解锁</div>
      <div class="w11-lock-curtain-tray" title="以太网: Internet 访问">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="2" y="4" width="14" height="10" rx="1.2" stroke="currentColor" stroke-width="1.6"/>
          <path d="M6 17H12M9 14V17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M18.5 7V15M18.5 7L21 9.5M18.5 7L16 9.5M18.5 15L21 12.5M18.5 15L16 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>

    <!-- Phase 2 & 3: 登录凭据界面与“欢迎”过渡 -->
    <div class="w11-signin-pane" data-signin-pane>
      <div class="w11-signin-card">
        <div class="w11-signin-avatar" aria-hidden="true">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none">
            <circle cx="32" cy="21" r="10.5" fill="rgba(255,255,255,0.92)"/>
            <path d="M16.5 47.5C17.8 39.2 24.1 34.5 32 34.5C39.9 34.5 46.2 39.2 47.5 47.5C47.8 49.4 46.3 51 44.4 51H19.6C17.7 51 16.2 49.4 16.5 47.5Z" fill="rgba(255,255,255,0.92)"/>
          </svg>
        </div>
        <h2 class="w11-signin-user">admin</h2>

        <form class="w11-signin-form" data-signin-form autocomplete="off">
          <div class="w11-signin-input-box">
            <input
              type="password"
              class="w11-signin-input"
              data-signin-input
              placeholder="密码"
              aria-label="密码"
              autocomplete="off"
              spellcheck="false"
            />
            <button type="button" class="w11-signin-eye" data-signin-eye hidden title="显示密码" aria-label="显示密码">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M1.5 8C3 4.8 5.3 3.5 8 3.5C10.7 3.5 13 4.8 14.5 8C13 11.2 10.7 12.5 8 12.5C5.3 12.5 3 11.2 1.5 8Z" stroke="currentColor" stroke-width="1.25"/>
                <circle cx="8" cy="8" r="2" fill="currentColor"/>
              </svg>
            </button>
            <button type="submit" class="w11-signin-submit" title="提交" aria-label="提交密码">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
                <path d="M3 8H13M13 8L8.8 3.8M13 8L8.8 12.2" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          <div class="w11-signin-tip">输入密码 <code>qwer1234</code> 登录</div>
        </form>

        <div class="w11-signin-error" data-signin-error hidden>
          <p class="w11-signin-error-msg">密码不正确。请再试一次。</p>
          <p class="w11-signin-error-hint">密码提示: qwer1234</p>
          <button type="button" class="w11-signin-ok-btn" data-signin-ok>确定</button>
        </div>

        <div class="w11-signin-welcome" data-signin-welcome hidden>
          <div class="w11-signin-spinner" aria-hidden="true"></div>
          <div class="w11-signin-welcome-text" data-welcome-text>欢迎</div>
        </div>
      </div>

      <div class="w11-signin-tray">
        <button type="button" class="w11-signin-tray-btn is-ime" data-signin-ime title="输入法切换">英</button>
        <span class="w11-signin-tray-pill" data-signin-ime-badge>拼</span>
        <button type="button" class="w11-signin-tray-btn" title="网络: 以太网 (Internet 访问)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <rect x="2" y="4" width="14" height="10" rx="1.2" stroke="currentColor" stroke-width="1.6"/>
            <path d="M6 17H12M9 14V17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M18.5 7V15M18.5 7L21 9.5M18.5 7L16 9.5M18.5 15L21 12.5M18.5 15L16 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button type="button" class="w11-signin-tray-btn" title="辅助功能" data-signin-a11y>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="5.5" r="2" fill="currentColor"/>
            <path d="M6 9.5H18M12 9.5V14.5M12 14.5L8.5 20.5M12 14.5L15.5 20.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="w11-signin-power-wrap">
          <button type="button" class="w11-signin-tray-btn" data-signin-power title="电源">
            <span set:html={UI_ICONS.power} />
          </button>
          <div class="w11-power-popover is-login" data-signin-power-menu hidden role="menu">
            <button type="button" class="w11-power-item" data-login-power="sleep">睡眠</button>
            <button type="button" class="w11-power-item" data-login-power="lock">返回锁屏</button>
            <button type="button" class="w11-power-item" data-login-power="restart">重启</button>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-win11-root]');
    if (!root) return;
    var vw = window.innerWidth;
    var vh = window.innerHeight;
    if (vw < 1024 || vh < 580) {
      var rdpW = 1920;
      var rdpH = vw > vh ? Math.max(720, Math.round((vh * rdpW) / vw)) : 1080;
      var s = vw > vh ? vw / rdpW : Math.min(vw / rdpW, vh / rdpH);
      root.classList.add('is-rdp-scaled');
      root.style.setProperty('--w11-rdp-w', rdpW + 'px');
      root.style.setProperty('--w11-rdp-h', rdpH + 'px');
      root.style.setProperty('--w11-scale', String(s));
    }
  })();
</script>

<script>
  import { initWin11Desktop } from './desktop';

  const root = document.querySelector<HTMLElement>('[data-win11-root]');
  if (root) {
    initWin11Desktop(root);
  }
</script>

<style is:global>
  @font-face {
    font-family: 'FluentSystemIcons-Regular';
    src: url('/ui-design/FluentSystemIcons-Regular.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
  }

  .w11-shell {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    color: var(--win-text);
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .w11-shell.is-rdp-scaled {
    width: var(--w11-rdp-w, 1920px);
    height: var(--w11-rdp-h, 1080px);
    flex-shrink: 0;
    transform: scale(var(--w11-scale, 1));
    transform-origin: center center;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08), 0 24px 80px rgba(0, 0, 0, 0.72);
  }

  .w11-shell input,
  .w11-shell textarea {
    user-select: text;
    -webkit-user-select: text;
    -webkit-touch-callout: default;
  }

  .w11-wallpaper {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-color: var(--win-bg-fallback);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: background-image 220ms ease;
  }

  .w11-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity 150ms ease;
  }

  .w11-overlay--brightness {
    z-index: 9500;
    background: #000;
    opacity: 0;
  }

  .w11-overlay--nightlight {
    z-index: 9499;
    background: #ff9e44;
    mix-blend-mode: multiply;
    opacity: 0;
  }

  .w11-desktop-area {
    position: absolute;
    inset: 0 0 48px 0;
    z-index: 1;
    touch-action: none;
    -webkit-touch-callout: none;
  }

  .w11-desktop-icons {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .w11-desktop-icons.is-refreshing {
    opacity: 0;
  }

  .w11-desktop-icon {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 5px;
    padding: 6px 4px;
    border: 1px solid transparent;
    border-radius: 4px;
    background: transparent;
    color: #ffffff;
    cursor: default;
    touch-action: none;
    -webkit-touch-callout: none;
    transition: background-color 120ms ease, border-color 120ms ease;
  }

  .w11-desktop-icon:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .w11-desktop-icon.is-selected {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.34);
  }

  .w11-desktop-icon.is-dragging {
    opacity: 0.82;
    z-index: 20;
    pointer-events: none;
  }

  .w11-desktop-icon__glyph {
    display: grid;
    place-items: center;
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.42));
  }

  .w11-desktop-icon__label {
    font-size: 12px;
    line-height: 1.25;
    text-align: center;
    text-wrap: balance;
    word-break: break-word;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.92), 0 0 6px rgba(0, 0, 0, 0.72);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .w11-marquee {
    display: none;
    position: absolute;
    z-index: 15;
    background: rgba(0, 120, 212, 0.24);
    border: 1px solid rgba(96, 205, 255, 0.92);
    pointer-events: none;
  }

  /* 窗口贴靠预览与窗口容器 */
  .w11-snap-preview {
    position: absolute;
    z-index: 199;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(18px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease, left 120ms ease, top 120ms ease, width 120ms ease, height 120ms ease;
  }

  .w11-snap-preview.is-visible {
    opacity: 1;
  }

  .w11-windows-layer {
    position: absolute;
    inset: 0 0 48px 0;
    z-index: 100;
    pointer-events: none;
  }

  .w11-window {
    position: absolute;
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    background: var(--win-mica-bg);
    border-radius: 8px;
    box-shadow: var(--win-shadow-window-inactive);
    overflow: hidden;
    transition: opacity 140ms ease, transform 140ms ease;
  }

  .w11-window.is-active {
    box-shadow: var(--win-shadow-window);
  }

  .w11-window.is-maximized {
    border-radius: 0;
  }

  .w11-window.is-minimized {
    opacity: 0;
    transform: translateY(24px) scale(0.96);
    pointer-events: none;
  }

  .w11-win-titlebar {
    height: 36px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-left: 12px;
    background: var(--win-titlebar-inactive);
    border-bottom: 1px solid var(--win-divider);
    touch-action: none;
  }

  .w11-window.is-active .w11-win-titlebar {
    background: var(--win-mica-bg);
  }

  .w11-window.is-seamless-app .w11-win-titlebar {
    height: 40px;
    padding-left: 14px;
    border-bottom: none;
    background: #282828;
  }

  :root[data-theme='light'] .w11-window.is-seamless-app .w11-win-titlebar {
    background: #e8e8e8;
  }

  .w11-window.is-seamless-app.is-active .w11-win-titlebar {
    background: #202020;
  }

  :root[data-theme='light'] .w11-window.is-seamless-app.is-active .w11-win-titlebar {
    background: #f3f3f3;
  }

  .w11-win-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--win-text-secondary);
    min-width: 0;
  }

  .w11-window.is-active .w11-win-title {
    color: var(--win-text);
  }

  .w11-win-title-icon {
    display: grid;
    place-items: center;
  }

  .w11-win-title-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .w11-win-controls {
    display: flex;
    height: 100%;
  }

  .w11-win-ctrl {
    width: 46px;
    height: 100%;
    border: none;
    background: transparent;
    color: var(--win-text);
    display: grid;
    place-items: center;
    cursor: default;
    transition: background-color 100ms ease, color 100ms ease;
  }

  .w11-win-ctrl:hover {
    background: var(--win-hover);
  }

  .w11-win-ctrl.is-close:hover {
    background: #c42b1c;
    color: #ffffff;
  }

  .w11-win-body {
    flex: 1;
    min-height: 0;
    position: relative;
    overflow: auto;
    background: var(--win-mica-bg);
  }

  .w11-win-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background: var(--win-mica-bg);
  }

  .w11-windows-layer.is-interacting .w11-win-iframe {
    pointer-events: none;
  }

  .w11-stub {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 28px;
    text-align: center;
  }

  .w11-stub h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }

  .w11-stub p {
    margin: 0;
    font-size: 13px;
    color: var(--win-text-secondary);
  }

  .w11-stub-badge {
    margin-top: 4px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 11px;
    background: var(--win-card-bg);
    border: 1px solid var(--win-border);
    color: var(--win-text-secondary);
  }

  .w11-stub--panel {
    align-items: stretch;
    justify-content: flex-start;
    text-align: left;
    gap: 16px;
  }

  .w11-stub-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .w11-stub-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .w11-stub-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
    border-radius: 6px;
    background: var(--win-card-bg);
    border: 1px solid var(--win-border);
  }

  .w11-stub-row strong {
    display: block;
    font-size: 13.5px;
    font-weight: 500;
  }

  .w11-stub-row span {
    font-size: 12px;
    color: var(--win-text-secondary);
  }

  .w11-pill-group {
    display: flex;
    gap: 6px;
  }

  .w11-pill-btn {
    padding: 5px 12px;
    border-radius: 4px;
    border: 1px solid var(--win-border-strong);
    background: var(--win-card-bg);
    color: var(--win-text);
    font-size: 12px;
    cursor: pointer;
  }

  .w11-pill-btn:hover {
    background: var(--win-hover);
  }

  .w11-pill-btn.is-active {
    background: var(--win-accent);
    border-color: var(--win-accent);
    color: var(--win-accent-text);
    font-weight: 600;
  }


  /* 8向窗口缩放手柄 */
  .w11-resize-handle {
    position: absolute;
    z-index: 10;
    touch-action: none;
  }
  .w11-window.is-maximized .w11-resize-handle,
  .w11-window.is-non-resizable .w11-resize-handle {
    display: none;
  }
  .w11-resize-handle.is-n { top: -3px; left: 8px; right: 8px; height: 6px; cursor: ns-resize; }
  .w11-resize-handle.is-s { bottom: -3px; left: 8px; right: 8px; height: 6px; cursor: ns-resize; }
  .w11-resize-handle.is-e { right: -3px; top: 8px; bottom: 8px; width: 6px; cursor: ew-resize; }
  .w11-resize-handle.is-w { left: -3px; top: 8px; bottom: 8px; width: 6px; cursor: ew-resize; }
  .w11-resize-handle.is-nw { top: -3px; left: -3px; width: 10px; height: 10px; cursor: nwse-resize; }
  .w11-resize-handle.is-ne { top: -3px; right: -3px; width: 10px; height: 10px; cursor: nesw-resize; }
  .w11-resize-handle.is-sw { bottom: -3px; left: -3px; width: 10px; height: 10px; cursor: nesw-resize; }
  .w11-resize-handle.is-se { bottom: -3px; right: -3px; width: 10px; height: 10px; cursor: nwse-resize; }

  /* 底部任务栏（中性磨砂灰亚克力与 Windows 11 原生比例） */
  .w11-taskbar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 48px;
    z-index: 1000;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    touch-action: manipulation;
    padding: 0 0 0 12px;
    background: var(--win-taskbar-bg);
    -webkit-backdrop-filter: blur(32px) saturate(125%);
    backdrop-filter: blur(32px) saturate(125%);
    border-top: 1px solid var(--win-border);
    font-family: var(--win-font-sans);
  }

  .w11-taskbar-center {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 100%;
  }

  .w11-taskbar-apps {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .w11-tb-item {
    position: relative;
    width: 40px;
    height: 40px;
    border: 1px solid transparent;
    border-radius: 4px;
    background: transparent;
    display: grid;
    place-items: center;
    cursor: default;
    transition: background-color 140ms ease, transform 90ms ease;
  }

  .w11-tb-item:hover {
    background: var(--win-hover);
  }

  .w11-tb-item.is-active,
  .w11-tb-item.is-focused {
    background: var(--win-active);
    border-color: var(--win-border);
  }

  .w11-tb-item:active .w11-tb-glyph {
    transform: scale(0.8);
  }

  .w11-tb-glyph {
    display: grid;
    place-items: center;
    transition: transform 110ms ease;
  }

  .w11-tb-indicator {
    position: absolute;
    bottom: 1px;
    width: 0;
    height: 3px;
    border-radius: 999px;
    background: #858585;
    transition: width 180ms ease, background-color 180ms ease;
  }

  .w11-tb-item.is-open .w11-tb-indicator {
    width: 6px;
  }

  .w11-tb-item.is-focused .w11-tb-indicator {
    width: 14px;
    background: var(--win-accent);
  }

  .w11-tb-search-pill {
    height: 32px;
    min-width: 136px;
    padding: 0 14px 0 12px;
    margin: 0 2px;
    border-radius: 999px;
    border: 1px solid var(--win-border);
    background: rgba(255, 255, 255, 0.10);
    color: var(--win-text);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 400;
    cursor: default;
    transition: background-color 120ms ease;
  }

  [data-theme='light'] .w11-tb-search-pill {
    background: rgba(255, 255, 255, 0.65);
  }

  .w11-tb-search-pill:hover {
    background: var(--win-card-hover);
  }

  .w11-tb-search-icon {
    display: grid;
    place-items: center;
    opacity: 0.9;
  }

  .w11-taskbar-tray {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 2px;
    height: 100%;
    padding-right: 4px;
  }

  .w11-tray-btn {
    height: 38px;
    padding: 0 7px;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: var(--win-text);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 400;
    cursor: default;
    transition: background-color 100ms ease;
  }

  .w11-tray-btn:hover {
    background: var(--win-hover);
  }

  .w11-tray-btn.is-active {
    background: var(--win-active);
  }

  .w11-tray-ime {
    min-width: 28px;
    justify-content: center;
    font-size: 13px;
    font-weight: 400;
  }

  .w11-tray-clock {
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 1px;
    padding: 0 10px;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }

  .w11-clock-time,
  .w11-clock-date {
    font-size: 12px;
    font-weight: 400;
    color: var(--win-text);
  }

  .w11-show-desktop {
    width: 6px;
    height: 100%;
    margin-left: 2px;
    border: none;
    border-left: 1px solid transparent;
    background: transparent;
    cursor: default;
  }

  .w11-show-desktop:hover {
    border-left-color: var(--win-border-strong);
    background: var(--win-hover);
  }

  /* 通用 Flyout 弹窗 */
  .w11-flyout {
    position: absolute;
    z-index: 950;
    background: var(--win-flyout-bg);
    -webkit-backdrop-filter: saturate(2) blur(28px);
    backdrop-filter: saturate(2) blur(28px);
    border-radius: 8px;
    box-shadow: var(--win-shadow-flyout);
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    transition: opacity 160ms cubic-bezier(0.16, 1, 0.3, 1), transform 190ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .w11-flyout.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* 开始菜单 */
  .w11-start-menu {
    left: 50%;
    bottom: 60px;
    width: min(620px, calc(100% - 24px));
    transform: translate(-50%, 22px);
    overflow: hidden;
  }

  .w11-start-menu.is-open {
    transform: translate(-50%, 0);
  }

  .w11-start-search-wrap {
    margin: 24px 28px 18px;
    padding: 0 14px;
    height: 36px;
    border-radius: 999px;
    background: var(--win-card-bg);
    border: 1px solid var(--win-border);
    border-bottom: 2px solid var(--win-accent);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .w11-start-search-icon {
    color: var(--win-text-secondary);
    display: grid;
    place-items: center;
  }

  .w11-start-search {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    color: var(--win-text);
    font-size: 13px;
  }

  .w11-start-section-head {
    padding: 0 34px 12px;
    font-size: 13px;
    font-weight: 600;
  }

  .w11-start-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
    padding: 0 24px 26px;
    min-height: 196px;
    align-content: start;
  }

  .w11-start-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px 6px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--win-text);
    cursor: default;
    transition: background-color 110ms ease;
  }

  .w11-start-item:hover {
    background: var(--win-hover);
  }

  .w11-start-item__icon {
    display: grid;
    place-items: center;
  }

  .w11-start-item__name {
    font-size: 12px;
    line-height: 1.25;
    text-align: center;
  }

  .w11-start-empty {
    grid-column: 1 / -1;
    display: grid;
    place-items: center;
    color: var(--win-text-secondary);
    font-size: 13px;
    min-height: 140px;
  }

  .w11-start-footer {
    height: 60px;
    padding: 0 36px;
    background: rgba(0, 0, 0, 0.16);
    border-top: 1px solid var(--win-divider);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  [data-theme='light'] .w11-start-footer {
    background: rgba(0, 0, 0, 0.035);
  }

  .w11-start-user {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    font-weight: 500;
  }

  .w11-start-avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--win-card-hover);
    border: 1px solid var(--win-border);
    display: grid;
    place-items: center;
  }

  .w11-icon-btn {
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 5px;
    background: transparent;
    color: var(--win-text);
    display: grid;
    place-items: center;
    cursor: default;
  }

  .w11-icon-btn:hover {
    background: var(--win-hover);
  }

  /* 快速设置（对齐 win11React sidepane 布局与 Win11 滑块样式） */
  .w11-quick-settings {
    right: 12px;
    bottom: 60px;
    width: 360px;
    overflow: hidden;
  }

  .w11-qs-body {
    padding: 18px 18px 16px;
  }

  .w11-qs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px 12px;
    margin-bottom: 20px;
  }

  .w11-qs-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .w11-qs-tile {
    width: 100%;
    height: 46px;
    border-radius: 5px;
    border: 1px solid var(--win-border);
    background: var(--win-card-bg);
    color: var(--win-text);
    display: grid;
    place-items: center;
    cursor: default;
    transition: background-color 110ms ease, color 110ms ease;
  }

  .w11-qs-tile:hover {
    background: var(--win-card-hover);
  }

  .w11-qs-tile.is-active {
    background: var(--win-accent);
    border-color: var(--win-accent);
    color: var(--win-accent-text);
  }

  .w11-qs-tile__label {
    font-size: 11.5px;
    color: var(--win-text);
  }

  .w11-qs-sliders {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .w11-qs-slider-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .w11-qs-slider-icon {
    display: grid;
    place-items: center;
    color: var(--win-text-secondary);
  }

  .w11-qs-slider-row input[type='range'] {
    flex: 1;
    height: 4px;
    border-radius: 999px;
    -webkit-appearance: none;
    appearance: none;
    background: linear-gradient(
      90deg,
      var(--win-accent) var(--track-pct, 100%),
      rgba(136, 136, 136, 0.45) var(--track-pct, 100%)
    );
    cursor: pointer;
  }

  .w11-qs-slider-row input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--win-accent);
    border: 4px solid #ffffff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
    transition: transform 100ms ease;
  }

  .w11-qs-slider-row input[type='range']::-webkit-slider-thumb:hover {
    transform: scale(1.1);
  }

  .w11-qs-footer {
    height: 46px;
    padding: 0 14px 0 18px;
    border-top: 1px solid var(--win-divider);
    background: rgba(0, 0, 0, 0.14);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  [data-theme='light'] .w11-qs-footer {
    background: rgba(0, 0, 0, 0.03);
  }

  .w11-qs-battery {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--win-text-secondary);
  }

  /* 日历浮层 */
  .w11-calendar-flyout {
    right: 12px;
    bottom: 60px;
    width: 320px;
    padding: 16px;
  }

  .w11-cal-header {
    padding-bottom: 12px;
    margin-bottom: 10px;
    border-bottom: 1px solid var(--win-divider);
  }

  .w11-cal-today {
    font-size: 14px;
    font-weight: 600;
  }

  .w11-cal-month {
    margin-top: 3px;
    font-size: 12px;
    color: var(--win-text-secondary);
  }

  .w11-cal-weekdays,
  .w11-cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    text-align: center;
  }

  .w11-cal-weekdays {
    font-size: 11.5px;
    color: var(--win-text-secondary);
    margin-bottom: 6px;
  }

  .w11-cal-day {
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 12.5px;
  }

  .w11-cal-day:hover {
    background: var(--win-hover);
  }

  .w11-cal-day.is-muted {
    color: var(--win-text-tertiary);
  }

  .w11-cal-day.is-today {
    background: var(--win-accent);
    color: var(--win-accent-text);
    font-weight: 600;
  }

  /* 托盘溢出面板 */
  .w11-tray-overflow {
    right: 160px;
    bottom: 60px;
    padding: 8px;
    display: flex;
    gap: 6px;
  }

  .w11-tray-overflow__item {
    width: 34px;
    height: 34px;
    border-radius: 5px;
    display: grid;
    place-items: center;
  }

  .w11-tray-overflow__item:hover {
    background: var(--win-hover);
  }

  /* 右键菜单（Win11 经典紧凑比例） */
  .w11-context-menu {
    display: none;
    position: absolute;
    z-index: 2000;
    min-width: 174px;
    padding: 3px;
    border-radius: 6px;
    border: 1px solid var(--win-border);
    background: var(--win-menu-bg);
    -webkit-backdrop-filter: saturate(2) blur(24px);
    backdrop-filter: saturate(2) blur(24px);
    box-shadow: var(--win-shadow-menu);
  }

  .w11-context-menu.is-open {
    display: block;
  }

  .w11-ctx-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .w11-ctx-item {
    position: relative;
    height: 22px;
    padding: 0 8px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    line-height: 1;
    cursor: default;
  }

  .w11-ctx-item:hover:not(.is-disabled) {
    background: var(--win-hover);
  }

  .w11-ctx-item.is-disabled {
    opacity: 0.42;
    pointer-events: none;
  }

  .w11-ctx-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    color: var(--win-text-secondary);
  }

  .w11-ctx-icon svg {
    width: 14px;
    height: 14px;
    display: block;
  }

  .w11-ctx-dot {
    font-size: 11px;
    line-height: 1;
    color: var(--win-text);
  }

  .w11-ctx-checkglyph {
    font-size: 10px;
    line-height: 1;
    color: var(--win-text);
  }

  .w11-ctx-label {
    flex: 1;
    white-space: nowrap;
  }

  .w11-ctx-arrow {
    color: var(--win-text-secondary);
    font-size: 11px;
  }

  .w11-ctx-divider {
    height: 1px;
    margin: 3px 6px;
    background: var(--win-divider);
  }

  .w11-ctx-submenu {
    display: none;
    position: absolute;
    left: calc(100% + 2px);
    top: -3px;
    min-width: 136px;
    padding: 3px;
    border-radius: 6px;
    border: 1px solid var(--win-border);
    background: var(--win-menu-bg);
    -webkit-backdrop-filter: saturate(2) blur(24px);
    backdrop-filter: saturate(2) blur(24px);
    box-shadow: var(--win-shadow-menu);
  }

  .w11-ctx-item.has-sub.is-sub-open > .w11-ctx-submenu {
    display: flex;
  }

  /* 右侧浮动设计候选菜单 */
  .w11-dcp-panel {
    position: absolute;
    right: 14px;
    top: 82px;
    width: 204px;
    z-index: 900;
    background: rgba(30, 31, 34, 0.92);
    -webkit-backdrop-filter: saturate(1.4) blur(18px);
    backdrop-filter: saturate(1.4) blur(18px);
