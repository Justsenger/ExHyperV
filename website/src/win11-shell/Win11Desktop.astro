---
import { getAppIconSvg, UI_ICONS } from './icons';
---

<div class="w11-shell" data-win11-root>
  <!-- 真实 Windows 11 Bloom 壁纸与环境滤镜层 -->
  <div class="w11-wallpaper" data-wallpaper style="background-image: url('/win11/wallpapers/bloom-dark.webp');"></div>
  <div class="w11-overlay w11-overlay--brightness" data-brightness-overlay></div>
  <div class="w11-overlay w11-overlay--nightlight" data-nightlight-overlay></div>

  <!-- 桌面区域（图标网格 + 框选矩形） -->
  <main class="w11-desktop-area" data-desktop-area>
    <div class="w11-desktop-icons" data-icons-layer></div>
    <div class="w11-marquee" data-marquee></div>
  </main>

  <!-- 窗口贴靠预览与窗口管理层 -->
  <div class="w11-snap-preview" data-snap-preview></div>
  <div class="w11-windows-layer" data-windows-layer></div>

  <!-- 开始菜单 -->
  <section class="w11-flyout w11-start-menu" data-start-menu aria-label="开始菜单">
    <div class="w11-start-search-wrap">
      <span class="w11-start-search-icon" set:html={UI_ICONS.searchSmall} />
      <input
        type="text"
        class="w11-start-search"
        data-start-search
        placeholder="搜索应用、设置和文档"
        autocomplete="off"
      />
    </div>
    <div class="w11-start-section-head">
      <span>已固定</span>
    </div>
    <div class="w11-start-grid" data-start-grid></div>
    <footer class="w11-start-footer">
      <div class="w11-start-user">
        <span class="w11-start-avatar" set:html={UI_ICONS.user} />
        <span>Administrator</span>
      </div>
      <button type="button" class="w11-icon-btn" data-start-reset title="重置桌面布局">
        <span set:html={UI_ICONS.power} />
      </button>
    </footer>
  </section>

  <!-- 快速设置面板 -->
  <section class="w11-flyout w11-quick-settings" data-quick-settings aria-label="快速设置">
    <div class="w11-qs-body">
      <div class="w11-qs-grid">
        <div class="w11-qs-cell">
          <button type="button" class="w11-qs-tile" data-qs-toggle="wifi" aria-label="WLAN">
            <span class="w11-qs-tile__icon" set:html={UI_ICONS.wifi} />
          </button>
          <span class="w11-qs-tile__label">WLAN</span>
        </div>
        <div class="w11-qs-cell">
          <button type="button" class="w11-qs-tile" data-qs-toggle="bluetooth" aria-label="蓝牙">
            <span class="w11-qs-tile__icon" set:html={UI_ICONS.bluetooth} />
          </button>
          <span class="w11-qs-tile__label">蓝牙</span>
        </div>
        <div class="w11-qs-cell">
          <button type="button" class="w11-qs-tile" data-qs-toggle="airplane" aria-label="飞行模式">
            <span class="w11-qs-tile__icon" set:html={UI_ICONS.airplane} />
          </button>
          <span class="w11-qs-tile__label">飞行模式</span>
        </div>
        <div class="w11-qs-cell">
          <button type="button" class="w11-qs-tile" data-qs-toggle="theme" aria-label="深色外观">
            <span class="w11-qs-tile__icon" set:html={UI_ICONS.moon} />
          </button>
          <span class="w11-qs-tile__label">深色外观</span>
        </div>
        <div class="w11-qs-cell">
          <button type="button" class="w11-qs-tile" data-qs-toggle="nightLight" aria-label="夜间模式">
            <span class="w11-qs-tile__icon" set:html={UI_ICONS.brightness} />
          </button>
          <span class="w11-qs-tile__label">夜间模式</span>
        </div>
      </div>
      <div class="w11-qs-sliders">
        <label class="w11-qs-slider-row">
          <span class="w11-qs-slider-icon" set:html={UI_ICONS.brightness} />
          <input type="range" min="35" max="100" value="100" data-qs-brightness aria-label="屏幕亮度" />
        </label>
        <label class="w11-qs-slider-row">
          <span class="w11-qs-slider-icon" set:html={UI_ICONS.volume} />
          <input type="range" min="0" max="100" value="65" data-qs-volume aria-label="系统音量" />
        </label>
      </div>
    </div>
    <footer class="w11-qs-footer">
      <span class="w11-qs-battery">
        <span set:html={UI_ICONS.battery} />
        <span>92%</span>
      </span>
      <button type="button" class="w11-icon-btn" data-qs-open-settings title="所有设置">
        <span set:html={getAppIconSvg('settings', 16)} />
      </button>
    </footer>
  </section>

  <!-- 日历浮层 -->
  <section class="w11-flyout w11-calendar-flyout" data-calendar-flyout aria-label="日期与日历"></section>

  <!-- 托盘折叠浮层 -->
  <section class="w11-flyout w11-tray-overflow" data-tray-overflow aria-label="隐藏的托盘图标">
    <div class="w11-tray-overflow__item" title="Windows 安全中心">
      <span set:html={getAppIconSvg('start', 16)} />
    </div>
    <div class="w11-tray-overflow__item" title="任务管理器">
      <span set:html={getAppIconSvg('task-manager', 16)} />
    </div>
  </section>

  <!-- 全局右键菜单 -->
  <div class="w11-context-menu" data-context-menu></div>

  <!-- 右侧浮动设计候选菜单（与 ExHyperV 设备·显卡同步） -->
  <aside class="w11-dcp-panel" id="desktopCandidatesPanel" aria-label="显卡设计候选菜单">
    <div class="w11-dcp-header" id="desktopDcpHeader">
      <span class="w11-dcp-title">显卡界面候选</span>
      <button type="button" class="w11-dcp-toggle" id="desktopDcpCollapseBtn" title="收起/展开候选菜单">−</button>
    </div>
    <div class="w11-dcp-body" id="desktopDcpBody">
      <div class="w11-dcp-subhead">布局方案（多设备统一）</div>
      <div class="w11-dcp-list">
        <button class="w11-dcp-chip active" data-dcp-gpu-variant="expander" type="button">A · 经典 Expander</button>
        <button class="w11-dcp-chip" data-dcp-gpu-variant="tiles" type="button">B · 干净 KV 瓦片</button>
        <button class="w11-dcp-chip" data-dcp-gpu-variant="compact" type="button">C · 紧凑多设备行</button>
        <button class="w11-dcp-chip" data-dcp-gpu-variant="layered" type="button">D · 主卡 + 折叠策略</button>
      </div>
      <div class="w11-dcp-subhead">数据与异常状态</div>
      <div class="w11-dcp-list">
        <button class="w11-dcp-chip active" data-dcp-gpu-status="single" type="button">单卡（RTX 4090）</button>
        <button class="w11-dcp-chip" data-dcp-gpu-status="dual" type="button">双卡（4090 + 核显）</button>
        <button class="w11-dcp-chip" data-dcp-gpu-status="empty" type="button">未分配（空状态）</button>
        <button class="w11-dcp-chip" data-dcp-gpu-status="stale" type="button">路径失效（需重绑）</button>
        <button class="w11-dcp-chip" data-dcp-gpu-status="mmio-pending" type="button">MMIO 待优化</button>
      </div>
      <div class="w11-dcp-subhead">页面视图</div>
      <div class="w11-dcp-list">
        <button class="w11-dcp-chip active" data-dcp-gpu-mode="list" type="button">显卡列表主视图</button>
        <button class="w11-dcp-chip" data-dcp-gpu-mode="select" type="button">选择宿主显卡</button>
        <button class="w11-dcp-chip" data-dcp-gpu-mode="deploy" type="button">驱动部署流程</button>
      </div>
    </div>
  </aside>

  <!-- 底部任务栏 -->
  <footer class="w11-taskbar" data-taskbar>
    <div class="w11-taskbar-left"></div>
    <div class="w11-taskbar-center">
      <button type="button" class="w11-tb-item w11-tb-start" data-taskbar-start title="开始">
        <span class="w11-tb-glyph" set:html={getAppIconSvg('start', 24)} />
      </button>
      <button type="button" class="w11-tb-search-pill" data-taskbar-search title="搜索">
        <span class="w11-tb-search-icon" set:html={UI_ICONS.searchSmall} />
        <span>搜索</span>
      </button>
      <div class="w11-taskbar-apps" data-taskbar-apps></div>
    </div>
    <div class="w11-taskbar-tray">
      <button type="button" class="w11-tray-btn" data-taskbar-overflow title="显示隐藏的图标">
        <span set:html={UI_ICONS.chevronUp} />
      </button>
      <button type="button" class="w11-tray-btn w11-tray-ime" data-ime-btn title="切换输入法">中</button>
      <button type="button" class="w11-tray-btn w11-tray-quick" data-taskbar-quick title="网络、音量与电池">
        <span set:html={UI_ICONS.wifi} />
        <span set:html={UI_ICONS.volume} />
        <span set:html={UI_ICONS.battery} />
      </button>
      <button type="button" class="w11-tray-btn w11-tray-clock" data-taskbar-clock title="日期与时间">
        <span class="w11-clock-time" data-clock-time>20:00</span>
        <span class="w11-clock-date" data-clock-date>2026/11/15</span>
      </button>
      <button type="button" class="w11-show-desktop" data-show-desktop title="显示桌面" aria-label="显示桌面"></button>
    </div>
  </footer>
</div>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-win11-root]');
    if (!root) return;
    var vw = window.innerWidth;
    var vh = window.innerHeight;
    if (vw < 1024 || vh < 580) {
      var rdpW = 1920;
      var rdpH = vw > vh ? Math.max(720, Math.round((vh * rdpW) / vw)) : 1080;
      var s = vw > vh ? vw / rdpW : Math.min(vw / rdpW, vh / rdpH);
      root.classList.add('is-rdp-scaled');
      root.style.setProperty('--w11-rdp-w', rdpW + 'px');
      root.style.setProperty('--w11-rdp-h', rdpH + 'px');
      root.style.setProperty('--w11-scale', String(s));
    }
  })();
</script>

<script>
  import { initWin11Desktop } from './desktop';

  const root = document.querySelector<HTMLElement>('[data-win11-root]');
  if (root) {
    initWin11Desktop(root);
  }
</script>

<style is:global>
  @font-face {
    font-family: 'FluentSystemIcons-Regular';
    src: url('/ui-design/FluentSystemIcons-Regular.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
  }

  .w11-shell {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    color: var(--win-text);
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .w11-shell.is-rdp-scaled {
    width: var(--w11-rdp-w, 1920px);
    height: var(--w11-rdp-h, 1080px);
    flex-shrink: 0;
    transform: scale(var(--w11-scale, 1));
    transform-origin: center center;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08), 0 24px 80px rgba(0, 0, 0, 0.72);
  }

  .w11-shell input,
  .w11-shell textarea {
    user-select: text;
    -webkit-user-select: text;
    -webkit-touch-callout: default;
  }

  .w11-wallpaper {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-color: var(--win-bg-fallback);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: background-image 220ms ease;
  }

  .w11-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity 150ms ease;
  }

  .w11-overlay--brightness {
    z-index: 9500;
    background: #000;
    opacity: 0;
  }

  .w11-overlay--nightlight {
    z-index: 9499;
    background: #ff9e44;
    mix-blend-mode: multiply;
    opacity: 0;
  }

  .w11-desktop-area {
    position: absolute;
    inset: 0 0 48px 0;
    z-index: 1;
    touch-action: none;
    -webkit-touch-callout: none;
  }

  .w11-desktop-icons {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .w11-desktop-icons.is-refreshing {
    opacity: 0;
  }

  .w11-desktop-icon {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 5px;
    padding: 6px 4px;
    border: 1px solid transparent;
    border-radius: 4px;
    background: transparent;
    color: #ffffff;
    cursor: default;
    touch-action: none;
    -webkit-touch-callout: none;
    transition: background-color 120ms ease, border-color 120ms ease;
  }

  .w11-desktop-icon:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .w11-desktop-icon.is-selected {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.34);
  }

  .w11-desktop-icon.is-dragging {
    opacity: 0.82;
    z-index: 20;
    pointer-events: none;
  }

  .w11-desktop-icon__glyph {
    display: grid;
    place-items: center;
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.42));
  }

  .w11-desktop-icon__label {
    font-size: 12px;
    line-height: 1.25;
    text-align: center;
    text-wrap: balance;
    word-break: break-word;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.92), 0 0 6px rgba(0, 0, 0, 0.72);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .w11-marquee {
    display: none;
    position: absolute;
    z-index: 15;
    background: rgba(0, 120, 212, 0.24);
    border: 1px solid rgba(96, 205, 255, 0.92);
    pointer-events: none;
  }

  /* 窗口贴靠预览与窗口容器 */
  .w11-snap-preview {
    position: absolute;
    z-index: 199;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(18px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease, left 120ms ease, top 120ms ease, width 120ms ease, height 120ms ease;
  }

  .w11-snap-preview.is-visible {
    opacity: 1;
  }

  .w11-windows-layer {
    position: absolute;
    inset: 0 0 48px 0;
    z-index: 100;
    pointer-events: none;
  }

  .w11-window {
    position: absolute;
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    background: var(--win-mica-bg);
    border-radius: 8px;
    box-shadow: var(--win-shadow-window-inactive);
    overflow: hidden;
    transition: opacity 140ms ease, transform 140ms ease;
  }

  .w11-window.is-active {
    box-shadow: var(--win-shadow-window);
  }

  .w11-window.is-maximized {
    border-radius: 0;
  }

  .w11-window.is-minimized {
    opacity: 0;
    transform: translateY(24px) scale(0.96);
    pointer-events: none;
  }

  .w11-win-titlebar {
    height: 36px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-left: 12px;
    background: var(--win-titlebar-inactive);
    border-bottom: 1px solid var(--win-divider);
    touch-action: none;
  }

  .w11-window.is-active .w11-win-titlebar {
    background: var(--win-mica-bg);
  }

  .w11-window.is-seamless-app .w11-win-titlebar {
    height: 40px;
    padding-left: 14px;
    border-bottom: none;
    background: #282828;
  }

  :root[data-theme='light'] .w11-window.is-seamless-app .w11-win-titlebar {
    background: #e8e8e8;
  }

  .w11-window.is-seamless-app.is-active .w11-win-titlebar {
    background: #202020;
  }

  :root[data-theme='light'] .w11-window.is-seamless-app.is-active .w11-win-titlebar {
    background: #f3f3f3;
  }

  .w11-win-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--win-text-secondary);
    min-width: 0;
  }

  .w11-window.is-active .w11-win-title {
    color: var(--win-text);
  }

  .w11-win-title-icon {
    display: grid;
    place-items: center;
  }

  .w11-win-title-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .w11-win-controls {
    display: flex;
    height: 100%;
  }

  .w11-win-ctrl {
    width: 46px;
    height: 100%;
    border: none;
    background: transparent;
    color: var(--win-text);
    display: grid;
    place-items: center;
    cursor: default;
    transition: background-color 100ms ease, color 100ms ease;
  }

  .w11-win-ctrl:hover {
    background: var(--win-hover);
  }

  .w11-win-ctrl.is-close:hover {
    background: #c42b1c;
    color: #ffffff;
  }

  .w11-win-body {
    flex: 1;
    min-height: 0;
    position: relative;
    overflow: auto;
    background: var(--win-mica-bg);
  }

  .w11-win-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background: var(--win-mica-bg);
  }

  .w11-windows-layer.is-interacting .w11-win-iframe {
    pointer-events: none;
  }

  .w11-stub {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 28px;
    text-align: center;
  }

  .w11-stub h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }

  .w11-stub p {
    margin: 0;
    font-size: 13px;
    color: var(--win-text-secondary);
  }

  .w11-stub-badge {
    margin-top: 4px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 11px;
    background: var(--win-card-bg);
    border: 1px solid var(--win-border);
    color: var(--win-text-secondary);
  }

  .w11-stub--panel {
    align-items: stretch;
    justify-content: flex-start;
    text-align: left;
    gap: 16px;
  }

  .w11-stub-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .w11-stub-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .w11-stub-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
    border-radius: 6px;
    background: var(--win-card-bg);
    border: 1px solid var(--win-border);
  }

  .w11-stub-row strong {
    display: block;
    font-size: 13.5px;
    font-weight: 500;
  }

  .w11-stub-row span {
    font-size: 12px;
    color: var(--win-text-secondary);
  }

  .w11-pill-group {
    display: flex;
    gap: 6px;
  }

  .w11-pill-btn {
    padding: 5px 12px;
    border-radius: 4px;
    border: 1px solid var(--win-border-strong);
    background: var(--win-card-bg);
    color: var(--win-text);
    font-size: 12px;
    cursor: pointer;
  }

  .w11-pill-btn:hover {
    background: var(--win-hover);
  }

  .w11-pill-btn.is-active {
    background: var(--win-accent);
    border-color: var(--win-accent);
    color: var(--win-accent-text);
    font-weight: 600;
  }

  .w11-tm-probe {
    margin: 0 0 14px;
    padding: 12px 14px;
    max-height: 290px;
    overflow: auto;
    border-radius: 8px;
    border: 1px solid var(--win-divider);
    background: var(--win-card-bg);
    color: var(--win-text);
    font-family: 'Cascadia Code', 'Consolas', ui-monospace, monospace;
    font-size: 12px;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
    user-select: text;
    -webkit-user-select: text;
  }

  .w11-tm-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
  }

  .w11-tm-table th,
  .w11-tm-table td {
    padding: 10px 12px;
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid var(--win-divider);
  }

  .w11-tm-table th {
    color: var(--win-text-secondary);
    font-weight: 500;
  }

  .w11-tm-name {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Win11 任务管理器 1:1 原图像素对齐 */
  .w11-window[data-app='task-manager'] {
    background: #202020;
    color: #f3f3f3;
  }

  .w11-window[data-app='task-manager'] .w11-win-titlebar {
    height: 40px;
    padding-left: 14px;
    background: #202020 !important;
    color: #f3f3f3;
    border-bottom: none;
  }

  .w11-window[data-app='task-manager'] .w11-win-ctrl {
    color: #f3f3f3;
  }

  .w11-window[data-app='task-manager'] .w11-win-body {
    overflow: hidden;
    background: #202020;
  }

  .w11-tm-shell {
    display: flex;
    height: 100%;
    min-height: 0;
    background: #202020;
    color: #f3f3f3;
    font-size: 12px;
    font-family: 'Segoe UI Variable Text', 'Segoe UI', 'Microsoft YaHei UI', sans-serif;
  }

  .w11-tm-shell *::-webkit-scrollbar {
    width: 5px;
    height: 5px;
  }

  .w11-tm-shell *::-webkit-scrollbar-track {
    background: transparent;
  }

  .w11-tm-shell *::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 999px;
  }

  .w11-tm-nav {
    width: 48px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 6px 4px 10px;
    background: #202020;
    transition: width 0.14s ease;
  }

  .w11-tm-nav-top {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .w11-tm-shell.is-nav-expanded .w11-tm-nav {
    width: 156px;
  }

  .w11-tm-nav-btn {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    height: 40px;
    padding: 0 12px;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: #e4e4e4;
    cursor: pointer;
    text-align: left;
    overflow: hidden;
    white-space: nowrap;
  }

  .w11-tm-nav-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.06);
  }

  .w11-tm-nav-btn.is-muted {
    color: #d0d0d0;
    cursor: default;
  }

  .w11-tm-nav-btn.is-active {
    background: rgba(255, 255, 255, 0.065);
    color: #ffffff;
  }

  .w11-tm-nav-btn.is-active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 11px;
    bottom: 11px;
    width: 3px;
    border-radius: 2px;
    background: #4cc2ff;
  }

  .w11-tm-nav-icon {
    width: 16px;
    height: 16px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .w11-tm-fi {
    font-family: 'Segoe Fluent Icons', 'Segoe MDL2 Assets', 'FluentSystemIcons-Regular', sans-serif;
    font-style: normal;
    font-weight: normal;
    font-size: 16px;
    line-height: 1;
    width: 16px;
    height: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .w11-tm-fi-fluent {
    font-family: 'FluentSystemIcons-Regular', 'Segoe Fluent Icons', sans-serif;
  }

  .w11-tm-fi svg {
    width: 16px;
    height: 16px;
    display: block;
    fill: currentColor;
  }

  .w11-tm-nav-icon svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  .w11-tm-nav-text {
    font-size: 13px;
    opacity: 0;
    transition: opacity 0.1s ease;
  }

  .w11-tm-shell.is-nav-expanded .w11-tm-nav-text {
    opacity: 1;
  }

  .w11-tm-workspace {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #1c1c1c;
    border-top-left-radius: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.045);
    border-left: 1px solid rgba(255, 255, 255, 0.045);
  }

  .w11-tm-topbar {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding: 0 14px 0 22px;
    border-bottom: 1px solid #282828;
    flex-shrink: 0;
  }

  .w11-tm-page-title {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    color: #f3f3f3;
    margin-right: auto;
  }

  .w11-tm-search {
    width: 260px;
    max-width: 45%;
    height: 28px;
    padding: 0 10px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.45);
    background: #2b2b2b;
    color: #f3f3f3;
    font-size: 12px;
    outline: none;
  }

  .w11-tm-search:focus {
    border-bottom: 2px solid #4cc2ff;
  }

  .w11-tm-cmd-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .w11-tm-cmd-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 10px;
    border-radius: 4px;
    border: none;
    background: transparent;
    color: #f3f3f3;
    font-size: 12.5px;
    cursor: pointer;
    white-space: nowrap;
  }

  .w11-tm-cmd-btn .w11-tm-fi,
  .w11-tm-cmd-btn svg {
    width: 16px;
    height: 16px;
    font-size: 16px;
    flex-shrink: 0;
  }

  .w11-tm-cmd-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.07);
  }

  .w11-tm-cmd-btn:disabled {
    color: rgba(255, 255, 255, 0.35);
    cursor: default;
  }

  .w11-tm-cmd-more {
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: #f3f3f3;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .w11-tm-cmd-more .w11-tm-fi,
  .w11-tm-cmd-more svg {
    width: 16px;
    height: 16px;
    font-size: 16px;
    display: block;
  }

  .w11-tm-cmd-more:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  .w11-tm-content {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .w11-tm-perf-layout {
    display: flex;
    height: 100%;
    min-height: 0;
  }

  .w11-tm-perf-list {
    width: 248px;
    min-width: 172px;
    max-width: 440px;
    flex-shrink: 0;
    padding: 8px 8px 8px 10px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .w11-tm-perf-splitter {
    width: 8px;
    margin: 8px -3px;
    flex-shrink: 0;
    cursor: col-resize;
    position: relative;
    z-index: 2;
    touch-action: none;
    user-select: none;
  }

  .w11-tm-perf-splitter::after {
    content: '';
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 3px;
    width: 2px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    transition: background 0.12s ease;
  }

  .w11-tm-perf-splitter:hover::after,
  .w11-tm-perf-splitter.is-dragging::after {
    background: rgba(76, 194, 255, 0.72);
  }

  .w11-tm-perf-card {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 8px 10px;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: #f3f3f3;
    text-align: left;
    cursor: pointer;
  }

  .w11-tm-perf-card:hover {
    background: rgba(255, 255, 255, 0.045);
  }

  .w11-tm-perf-card.is-active {
    background: #2d2d2d;
  }

  .w11-tm-perf-thumb {
    width: 58px;
    height: 40px;
    flex-shrink: 0;
    background: #181818;
    border: 1px solid #4d4d4d;
    overflow: hidden;
  }

  .w11-tm-perf-meta {
    min-width: 0;
    flex: 1;
  }

  .w11-tm-perf-title {
    font-size: 13.5px;
    font-weight: 400;
    color: #f3f3f3;
    line-height: 1.25;
    margin-bottom: 1px;
  }

  .w11-tm-perf-sub {
    font-size: 11.5px;
    color: #b8b8b8;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .w11-tm-perf-detail {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 16px 28px 16px 24px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
  }

  .w11-tm-detail-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-bottom: 6px;
  }

  .w11-tm-detail-head h2 {
    margin: 0;
    font-size: 26px;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.15;
  }

  .w11-tm-detail-hw {
    font-size: 16px;
    color: #f3f3f3;
    font-weight: 400;
  }

  .w11-tm-chart-caption {
    display: flex;
    justify-content: space-between;
    font-size: 11.5px;
    color: #9c9c9c;
    margin: 0 0 4px;
    flex-shrink: 0;
  }

  .w11-tm-core-grid {
    flex: 1;
    min-height: 110px;
    display: grid;
    gap: 5px;
  }

  .w11-tm-core-cell {
    min-height: 0;
    border: 1px solid #484848;
    background: #181818;
    overflow: hidden;
  }

  .w11-tm-single-chart {
    flex: 1;
    min-height: 100px;
    border: 1px solid #484848;
    background: #181818;
    overflow: hidden;
  }

  .w11-tm-gpu-grid {
    flex: 1;
    min-height: 120px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 8px 10px;
    margin-bottom: 4px;
  }

  .w11-tm-gpu-box {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .w11-tm-gpu-box .w11-tm-core-cell {
    flex: 1;
    min-height: 0;
  }

  .w11-tm-mem-bar {
    display: flex;
    height: 36px;
    flex-shrink: 0;
    border: 1px solid rgba(79, 134, 214, 0.7);
    background: #191919;
    overflow: hidden;
  }

  .w11-tm-mem-used {
    background: rgba(59, 130, 246, 0.28);
    border-right: 1px solid #4f86d6;
  }

  .w11-tm-mem-compressed {
    width: 14px;
    background: rgba(96, 165, 250, 0.16);
    border-right: 1px solid #4f86d6;
  }

  .w11-tm-mem-standby {
    background: transparent;
    border-right: 1px solid rgba(79, 134, 214, 0.6);
  }

  .w11-tm-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .w11-tm-grid-lines line {
    stroke: rgba(255, 255, 255, 0.06);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .w11-tm-bottom-stats {
    display: flex;
    align-items: flex-start;
    gap: 56px;
    flex-shrink: 0;
    padding: 18px 0 4px;
  }

  .w11-tm-kpis {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 224px;
  }

  .w11-tm-kpi-row {
    display: flex;
    gap: 26px;
    flex-wrap: wrap;
  }

  .w11-tm-kpi {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .w11-tm-kpi > span {
    font-size: 12px;
    color: #a8a8a8;
    line-height: 1.25;
  }

  .w11-tm-kpi strong {
    font-size: 20px;
    font-weight: 400;
    line-height: 1.2;
    color: #f3f3f3;
    font-variant-numeric: tabular-nums;
  }

  .w11-tm-kv-table {
    display: grid;
    grid-template-columns: 98px auto;
    row-gap: 6px;
    column-gap: 22px;
    font-size: 12.5px;
    line-height: 1.38;
  }

  .w11-tm-kv-table.is-cpu-kv {
    grid-template-columns: 88px auto;
  }

  .w11-tm-kv-table.is-mem-kv {
    grid-template-columns: 124px auto;
  }

  .w11-tm-kv-table.is-disk-kv {
    grid-template-columns: 116px auto;
  }

  .w11-tm-kv-label {
    color: #a8a8a8;
  }

  .w11-tm-kv-val {
    color: #f3f3f3;
    font-variant-numeric: tabular-nums;
  }

  .w11-tm-inferred {
    color: #f6b94d !important;
  }

  .w11-tm-fake {
    color: #ff6b6b !important;
  }

  .w11-tm-proc-wrap {
    height: 100%;
    overflow: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
  }

  .w11-tm-proc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }

  .w11-tm-proc-table th {
    position: sticky;
    top: 0;
    z-index: 1;
    background: #191919;
    padding: 8px 12px;
    text-align: left;
    font-weight: 400;
    color: #bcbcbc;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    cursor: pointer;
    user-select: none;
  }

  .w11-tm-proc-table th.is-num {
    text-align: right;
    min-width: 82px;
  }

  .w11-tm-proc-table th.is-num div {
    font-size: 15px;
    font-weight: 400;
    color: #f3f3f3;
  }

  .w11-tm-proc-row {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    cursor: pointer;
  }

  .w11-tm-proc-row:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .w11-tm-proc-row.is-selected {
    outline: 1px solid #4cc2ff;
    outline-offset: -1px;
  }

  .w11-tm-proc-row td {
    padding: 5px 12px;
  }

  .w11-tm-num-cell {
    text-align: right;
    font-variant-numeric: tabular-nums;
    border-left: 1px solid rgba(255, 255, 255, 0.06);
  }

  .w11-tm-status-cell {
    color: #bcbcbc;
    font-size: 11.5px;
  }

  .w11-tm-empty {
    text-align: center;
    padding: 24px;
    color: #a6a6a6;
  }

  /* 8向窗口缩放手柄 */
  .w11-resize-handle {
    position: absolute;
    z-index: 10;
    touch-action: none;
  }
  .w11-window.is-maximized .w11-resize-handle {
    display: none;
  }
  .w11-resize-handle.is-n { top: -3px; left: 8px; right: 8px; height: 6px; cursor: ns-resize; }
  .w11-resize-handle.is-s { bottom: -3px; left: 8px; right: 8px; height: 6px; cursor: ns-resize; }
  .w11-resize-handle.is-e { right: -3px; top: 8px; bottom: 8px; width: 6px; cursor: ew-resize; }
  .w11-resize-handle.is-w { left: -3px; top: 8px; bottom: 8px; width: 6px; cursor: ew-resize; }
  .w11-resize-handle.is-nw { top: -3px; left: -3px; width: 10px; height: 10px; cursor: nwse-resize; }
  .w11-resize-handle.is-ne { top: -3px; right: -3px; width: 10px; height: 10px; cursor: nesw-resize; }
  .w11-resize-handle.is-sw { bottom: -3px; left: -3px; width: 10px; height: 10px; cursor: nesw-resize; }
  .w11-resize-handle.is-se { bottom: -3px; right: -3px; width: 10px; height: 10px; cursor: nwse-resize; }

  /* 底部任务栏（中性磨砂灰亚克力与 Windows 11 原生比例） */
  .w11-taskbar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 48px;
    z-index: 1000;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    touch-action: manipulation;
    padding: 0 0 0 12px;
    background: var(--win-taskbar-bg);
    -webkit-backdrop-filter: blur(32px) saturate(125%);
    backdrop-filter: blur(32px) saturate(125%);
    border-top: 1px solid var(--win-border);
    font-family: var(--win-font-sans);
  }

  .w11-taskbar-center {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 100%;
  }

  .w11-taskbar-apps {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .w11-tb-item {
    position: relative;
    width: 40px;
    height: 40px;
    border: 1px solid transparent;
    border-radius: 4px;
    background: transparent;
    display: grid;
    place-items: center;
    cursor: default;
    transition: background-color 140ms ease, transform 90ms ease;
  }

  .w11-tb-item:hover {
    background: var(--win-hover);
  }

  .w11-tb-item.is-active,
  .w11-tb-item.is-focused {
    background: var(--win-active);
    border-color: var(--win-border);
  }

  .w11-tb-item:active .w11-tb-glyph {
    transform: scale(0.8);
  }

  .w11-tb-glyph {
    display: grid;
    place-items: center;
    transition: transform 110ms ease;
  }

  .w11-tb-indicator {
    position: absolute;
    bottom: 1px;
    width: 0;
    height: 3px;
    border-radius: 999px;
    background: #858585;
    transition: width 180ms ease, background-color 180ms ease;
  }

  .w11-tb-item.is-open .w11-tb-indicator {
    width: 6px;
  }

  .w11-tb-item.is-focused .w11-tb-indicator {
    width: 14px;
    background: var(--win-accent);
  }

  .w11-tb-search-pill {
    height: 32px;
    min-width: 136px;
    padding: 0 14px 0 12px;
    margin: 0 2px;
    border-radius: 999px;
    border: 1px solid var(--win-border);
    background: rgba(255, 255, 255, 0.10);
    color: var(--win-text);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 400;
    cursor: default;
    transition: background-color 120ms ease;
  }

  [data-theme='light'] .w11-tb-search-pill {
    background: rgba(255, 255, 255, 0.65);
  }

  .w11-tb-search-pill:hover {
    background: var(--win-card-hover);
  }

  .w11-tb-search-icon {
    display: grid;
    place-items: center;
    opacity: 0.9;
  }

  .w11-taskbar-tray {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 2px;
    height: 100%;
    padding-right: 4px;
  }

  .w11-tray-btn {
    height: 38px;
    padding: 0 7px;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: var(--win-text);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 400;
    cursor: default;
    transition: background-color 100ms ease;
  }

  .w11-tray-btn:hover {
    background: var(--win-hover);
  }

  .w11-tray-btn.is-active {
    background: var(--win-active);
  }

  .w11-tray-ime {
    min-width: 28px;
    justify-content: center;
    font-size: 13px;
    font-weight: 400;
  }

  .w11-tray-clock {
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 1px;
    padding: 0 10px;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }

  .w11-clock-time,
  .w11-clock-date {
    font-size: 12px;
    font-weight: 400;
    color: var(--win-text);
  }

  .w11-show-desktop {
    width: 6px;
    height: 100%;
    margin-left: 2px;
    border: none;
    border-left: 1px solid transparent;
    background: transparent;
    cursor: default;
  }

  .w11-show-desktop:hover {
    border-left-color: var(--win-border-strong);
    background: var(--win-hover);
  }

  /* 通用 Flyout 弹窗 */
  .w11-flyout {
    position: absolute;
    z-index: 950;
    background: var(--win-flyout-bg);
    -webkit-backdrop-filter: saturate(2) blur(28px);
    backdrop-filter: saturate(2) blur(28px);
    border-radius: 8px;
    box-shadow: var(--win-shadow-flyout);
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    transition: opacity 160ms cubic-bezier(0.16, 1, 0.3, 1), transform 190ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .w11-flyout.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* 开始菜单 */
  .w11-start-menu {
    left: 50%;
    bottom: 60px;
    width: min(620px, calc(100% - 24px));
    transform: translate(-50%, 22px);
    overflow: hidden;
  }

  .w11-start-menu.is-open {
    transform: translate(-50%, 0);
  }

  .w11-start-search-wrap {
    margin: 24px 28px 18px;
    padding: 0 14px;
    height: 36px;
    border-radius: 999px;
    background: var(--win-card-bg);
    border: 1px solid var(--win-border);
    border-bottom: 2px solid var(--win-accent);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .w11-start-search-icon {
    color: var(--win-text-secondary);
    display: grid;
    place-items: center;
  }

  .w11-start-search {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    color: var(--win-text);
    font-size: 13px;
  }

  .w11-start-section-head {
    padding: 0 34px 12px;
    font-size: 13px;
    font-weight: 600;
  }

  .w11-start-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
    padding: 0 24px 26px;
    min-height: 196px;
    align-content: start;
  }

  .w11-start-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px 6px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--win-text);
    cursor: default;
    transition: background-color 110ms ease;
  }

  .w11-start-item:hover {
