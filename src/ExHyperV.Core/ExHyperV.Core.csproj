<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);external\**\runtimes\*\native\**;Contracts\**</DefaultItemExcludes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>2.0.0-Alpha</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RootNamespace>ExHyperV</RootNamespace>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Keep one build configuration for all consumers; MCP also reads these API comments. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en;zh-Hans;zh-CN</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ExHyperVConsoleRuntime)' != ''">
    <!-- Do not share an incrementally built desktop Core with dual-architecture consumers. -->
    <ArtifactsPivots>$(Configuration)_desktop_$(ExHyperVConsoleRuntime)</ArtifactsPivots>
    <OutputPath Condition="'$(UseArtifactsOutput)' != 'true'">bin\$(Configuration)\desktop_$(ExHyperVConsoleRuntime)\</OutputPath>
    <IntermediateOutputPath Condition="'$(UseArtifactsOutput)' != 'true'">$(BaseIntermediateOutputPath)$(Configuration)\desktop_$(ExHyperVConsoleRuntime)\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Contracts\**" />
    <EmbeddedResource Remove="Contracts\**" />
    <None Remove="Contracts\**" />
    <None Update="ThirdPartyNotices\SharpZipLib.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="external/freerdp/runtimes/win-arm64/console-native.zip"
        Condition="'$(ExHyperVConsoleRuntime)' == ''" LogicalName="ExHyperV.ConsoleNative.win-arm64.zip" />
    <EmbeddedResource Include="external/freerdp/runtimes/win-x64/console-native.zip"
        Condition="'$(ExHyperVConsoleRuntime)' == ''" LogicalName="ExHyperV.ConsoleNative.win-x64.zip" />
    <BrotliResource Include="external/freerdp/runtimes/$(ExHyperVConsoleRuntime)/console-native.zip" Kind="zip"
        Condition="'$(ExHyperVConsoleRuntime)' != ''" LogicalName="ExHyperV.ConsoleNative.$(ExHyperVConsoleRuntime).zip.br" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <InternalsVisibleTo Include="ExHyperV.CoreChecks" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/pci.ids" LogicalName="ExHyperV.Assets.pci.ids" />
  </ItemGroup>
  <Target Name="ValidateConsoleNativePackages" BeforeTargets="PrepareForBuild;GenerateNuspec" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(ExHyperVConsoleRuntime)' != '' And '$(ExHyperVConsoleRuntime)' != 'win-arm64' And '$(ExHyperVConsoleRuntime)' != 'win-x64'"
           Text="Unsupported console architecture: $(ExHyperVConsoleRuntime)" />
    <Error Condition="'%(EmbeddedResource.Extension)' == '.zip' And !Exists('%(EmbeddedResource.FullPath)')"
           Text="Core 缺少原生包 %(EmbeddedResource.Identity)。" />
  </Target>
  <Import Project="../../.github/build/winui-publish/CompressedResources.targets" />
</Project>
