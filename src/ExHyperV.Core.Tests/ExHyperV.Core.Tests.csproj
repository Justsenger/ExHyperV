<Project Sdk="MSTest.Sdk/4.5.2">
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <TestingExtensionsProfile>None</TestingExtensionsProfile>
    <EnableMicrosoftTestingExtensionsTrxReport>true</EnableMicrosoftTestingExtensionsTrxReport>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <GenerateTestingPlatformApplicationHelper>true</GenerateTestingPlatformApplicationHelper>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ExHyperV.ConsoleIpc/*.cs" Link="ConsoleIpc/%(Filename)%(Extension)" />
    <Compile Include="../ExHyperV.App/UI/Shared/ConsoleHost/ConsoleIpcHostConnector.cs" Link="Scenarios/%(Filename)%(Extension)" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.7" />
    <!-- Inspect App source with the compiler shipped in the selected SDK. -->
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(NetCoreRoot)sdk/$(NETCoreSdkVersion)/Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(NetCoreRoot)sdk/$(NETCoreSdkVersion)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="ResourceInspection/Page.html" />
    <EmbeddedResource Include="ResourceInspection/Assets/Tabler/tabler.min.css" />
    <EmbeddedResource Include="TestPlanning/TestCatalog.json" />
    <ProjectReference Include="../ExHyperV.Core/ExHyperV.Core.csproj" />
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <!-- Keep the existing diagnostic executable usable; share its verified scenarios. -->
    <Compile Include="../ExHyperV.App/Diagnostics/RollingLog.cs;../ExHyperV.App/Diagnostics/DiagnosticBundle.cs;../ExHyperV.App/Diagnostics/LocalTraceListener.cs" Link="Scenarios/%(Filename)%(Extension)" />
    <Compile Include="../ExHyperV.App/UI/Pages/VirtualMachines/Settings/Network/VmNetworkPolicyDraft.cs" Link="Scenarios/VmNetworkPolicyDraft.cs" />
    <Compile Include="../ExHyperV.App/DesktopJson.cs" Link="Scenarios/%(Filename)%(Extension)" />
    <Compile Include="../ExHyperV.App/UI/Shared/Appearance/AppearancePreferences.cs" Link="Scenarios/%(Filename)%(Extension)" />
    <Compile Include="../ExHyperV.App/UI/Shared/Appearance/ConsoleSessionModeConverter.cs" Link="Scenarios/%(Filename)%(Extension)" />
    <Compile Include="../ExHyperV.App/UI/Shared/ConsoleHost/ConsoleExtensionCatalog.cs" Link="Scenarios/%(Filename)%(Extension)" />
    <Compile Include="../ExHyperV.App/UI/Pages/VirtualMachines/Console/ConsoleFrameDamage.cs" Link="Scenarios/%(Filename)%(Extension)" />
    <Compile Include="../ExHyperV.App/UI/Pages/VirtualMachines/Console/ConsoleSessionState.cs" Link="Scenarios/%(Filename)%(Extension)" />
    <Compile Include="../ExHyperV.App/UI/Shared/ConsoleHost/ConsoleGpuDelivery.cs" Link="Scenarios/%(Filename)%(Extension)" />
    <Compile Include="../ExHyperV.App/UI/Pages/VirtualMachines/Console/FramePresenter.cs" Link="Scenarios/%(Filename)%(Extension)" />
    <Compile Include="../ExHyperV.App/UI/Pages/VirtualMachines/Console/ConsoleSwapChainRenderer.cs" Link="Scenarios/%(Filename)%(Extension)" />
    <Compile Include="../ExHyperV.App/UI/Pages/VirtualMachines/Console/ConsoleSwapChainRenderer.Shared.cs" Link="Scenarios/%(Filename)%(Extension)" />
    <Compile Include="../ExHyperV.App/UI/Pages/VirtualMachines/Console/ConsoleRenderWorker.cs" Link="Scenarios/%(Filename)%(Extension)" />
    <Compile Include="../ExHyperV.App/UI/Pages/VirtualMachines/Console/ConsoleSessionLifetime.cs" Link="Scenarios/ConsoleSessionLifetime.cs" />
    <Compile Remove="Diagnostics/**;Tools/**" />
    <Compile Include="Diagnostics/*Checks.cs"
             Exclude="Diagnostics/NativeChecks.cs;Diagnostics/HostNetworkChecks.cs"
             Link="Scenarios/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
