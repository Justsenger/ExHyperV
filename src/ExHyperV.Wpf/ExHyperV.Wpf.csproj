<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<AssemblyName>ExHyperV</AssemblyName>
		<RootNamespace>ExHyperV</RootNamespace>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<DefaultItemExcludes>$(DefaultItemExcludes);external\**</DefaultItemExcludes>
		<ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
		<PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
		<Nullable>enable</Nullable>
		<ApplicationIcon>Assets\Icon.ico</ApplicationIcon>
		<Version>2.0.0-Alpha</Version>
		<Authors>Justsenger</Authors>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<WpfUiGenerateDiagnosticMessages>False</WpfUiGenerateDiagnosticMessages>
		<SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
		<DebugType Condition=" '$(Configuration)' == 'Release' ">none</DebugType>
		<DebugSymbols Condition=" '$(Configuration)' == 'Release' ">false</DebugSymbols>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<PublishRoot Condition="'$(PublishRoot)' == ''">$(MSBuildProjectDirectory)\bin\publish-all</PublishRoot>
	</PropertyGroup>
	<!-- Authors 仅进 NuGet 元数据、不会自动生成运行时特性；显式发布为 AssemblyMetadata("Authors") 供 AppInfoService 读取，否则"关于"页作者回落为 Unknown -->
	<ItemGroup>
		<AssemblyMetadata Include="Authors" Value="$(Authors)" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="SSH.NET" Version="2026.0.0" />
		<PackageReference Include="System.Management" Version="10.0.8" />
		<ProjectReference Include="external\wpfui\src\Wpf.Ui\Wpf.Ui.csproj" />
		<ProjectReference Include="external\wpfui\src\Wpf.Ui.Tray\Wpf.Ui.Tray.csproj" />
		<!-- 展示定制依赖源码，由其各自项目编译，避免重复编入主程序。 -->
		<None Include="external\**\*" Exclude="external\**\bin\**;external\**\obj\**;external\**\__pycache__\**" />
		<Resource Include="Assets\**\*.*" Exclude="Assets\**\*.xaml;Assets\Icon.ico" />
		<Resource Include="Assets\Icon.ico" />
	</ItemGroup>
	<!-- VS 只安排解决方案内项目的构建；在实际编译前生成外部控件库，供编译和后续设计器使用。 -->
	<Target Name="BuildWpfUiForVisualStudio" BeforeTargets="ResolveProjectReferences"
		Condition="'$(MSBuildProjectName)' == 'ExHyperV.Wpf' and '$(BuildingInsideVisualStudio)' == 'true' and '$(BuildingProject)' == 'true' and '$(DesignTimeBuild)' != 'true'">
		<ItemGroup>
			<_WpfUiOutsideSolution Include="$(MSBuildProjectDirectory)\external\wpfui\src\Wpf.Ui\Wpf.Ui.csproj" />
			<_WpfUiOutsideSolution Include="$(MSBuildProjectDirectory)\external\wpfui\src\Wpf.Ui.Tray\Wpf.Ui.Tray.csproj" />
		</ItemGroup>
		<MSBuild Projects="@(_WpfUiOutsideSolution)" Targets="Build" BuildInParallel="false"
			Properties="BuildingInsideVisualStudio=false;BuildProjectReferences=true;DesignTimeBuild=false"
			RemoveProperties="CurrentSolutionConfigurationContents;SolutionPath;SolutionDir;SolutionName;SolutionFileName;SolutionExt"
			StopOnFirstFailure="true" />
	</Target>
	<Target Name="GodTierCleanupAfterPublish" AfterTargets="Publish">
		<!-- 清掉旧发布遗留物，保证重复发布到同一目录后仍只有一个 EXE。 -->
		<Delete Files="$(PublishDir)Wpf.Ui.dll;$(PublishDir)Wpf.Ui.Tray.dll;$(PublishDir)$(AssemblyName).pdb;$(PublishDir)Config.xml" Condition="'$(PublishSingleFile)' == 'true'" />

		<!-- 保留 SDK 生成的依赖布局；指定架构和单文件发布由 SDK 选择、打包运行实现。 -->
	</Target>
	<!-- 一个入口发布全部商店架构：
	     msbuild ExHyperV.Wpf.csproj /t:PublishAllArchitectures -->
	<Target Name="PublishAllArchitectures">
		<ItemGroup>
			<PublishArchitecture Include="win-x64;win-arm64" />
		</ItemGroup>
		<MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Restore;Publish" Properties="Configuration=Release;RuntimeIdentifier=%(PublishArchitecture.Identity);SelfContained=false;PublishSingleFile=true;DebugType=none;DebugSymbols=false;PublishDir=$(PublishRoot)\%(PublishArchitecture.Identity)\" StopOnFirstFailure="true" />
	</Target>
	<!-- Visual Studio 的 FolderProfile 在界面中保持“可移植的”，仅作为无架构发布入口；
	     入口完成后分别执行真正的 x64、ARM64 单文件发布。 -->
	<Target Name="PublishBothWindowsArchitecturesAfterVisualStudioPublish" AfterTargets="Publish" Condition="'$(PublishBothWindowsArchitectures)' == 'true' and '$(RuntimeIdentifier)' == ''">
		<ItemGroup>
			<VisualStudioPublishArchitecture Include="win-x64">
				<Suffix>x64</Suffix>
			</VisualStudioPublishArchitecture>
			<VisualStudioPublishArchitecture Include="win-arm64">
				<Suffix>arm64</Suffix>
			</VisualStudioPublishArchitecture>
		</ItemGroup>
		<Message Importance="high" Text="正在发布 x64 和 ARM64 单文件版本..." />
		<MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Restore;Publish" RemoveProperties="PublishProfile;PublishBothWindowsArchitectures" Properties="Configuration=Release;RuntimeIdentifier=%(VisualStudioPublishArchitecture.Identity);SelfContained=false;PublishSingleFile=true;DebugType=none;DebugSymbols=false;PublishDir=$(MSBuildProjectDirectory)\obj\publish-staging\%(VisualStudioPublishArchitecture.Identity)\" StopOnFirstFailure="true" />
		<Message Importance="high" Text="正在整理双架构发布文件..." />
		<RemoveDir Directories="$(FinalPublishDir)" />
		<MakeDir Directories="$(FinalPublishDir)" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)\obj\publish-staging\%(VisualStudioPublishArchitecture.Identity)\$(AssemblyName).exe" DestinationFiles="$(FinalPublishDir)$(AssemblyName)_V$(Version)_%(VisualStudioPublishArchitecture.Suffix).exe" />
		<RemoveDir Directories="$(MSBuildProjectDirectory)\obj\publish-staging" />
	</Target>
    <ItemGroup>
        <ProjectReference Include="..\ExHyperV.Core\ExHyperV.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
</Project>
