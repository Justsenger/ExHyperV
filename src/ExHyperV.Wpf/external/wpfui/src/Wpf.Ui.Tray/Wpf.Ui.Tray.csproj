<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WPF-UI.Tray</PackageId>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Description>Native tray menu icon support for WPF using the WPF UI library.</Description>
    <CommonTags>$(CommonTags);tray;notifyicon;notify</CommonTags>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="VisualStudioToolsManifest.xml" Pack="true" PackagePath="tools" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Controls\NotifyIcon.bmp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Controls\NotifyIcon.bmp" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <PackageReference Include="System.ValueTuple" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wpf.Ui\Wpf.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WpfAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(GeneratePackageOnBuild)' == 'true'">
    <None Include="$(RepositoryDirectory)\src\Wpf.Ui.Tray\README.md" Pack="true" PackagePath="\README.md" Visible="False" />
  </ItemGroup>

</Project>
