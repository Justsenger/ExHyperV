<ui:FluentWindow 
    xmlns:properties="clr-namespace:ExHyperV.Properties"
    x:Class="ExHyperV.UI.Windows.Console.ConsoleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    
    
    xmlns:controls="clr-namespace:ExHyperV.UI.Windows.Console"
    Title="{Binding VmName}"
    MinWidth="600"
    MinHeight="340"
    Width="1100"
    Height="820"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    Background="{DynamicResource ApplicationBackgroundBrush}">

    <ui:FluentWindow.Resources>
        <!-- Reserve caption-button space through TitleBar.CenterContent. The toolbar
             owns overflow; never clip away actions or enlarge the RDP viewport. -->
        <Style x:Key="ConsoleToolbarStyle" TargetType="ToolBar">
            <Setter Property="ToolBarTray.IsLocked" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolBar">
                        <DockPanel>
                            <ToggleButton x:Name="OverflowButton" DockPanel.Dock="Right"
                                          Width="32" Height="32" Padding="0"
                                          Visibility="{Binding HasOverflowItems, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"
                                          IsChecked="{Binding IsOverflowOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ToolTip="{x:Static properties:Resources.ConsoleWindow_MoreActions}"
                                          AutomationProperties.Name="{x:Static properties:Resources.ConsoleWindow_MoreActions}">
                                <TextBlock Text="⋯" FontSize="20" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsOverflowOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" PlacementTarget="{Binding ElementName=OverflowButton}"
                                   AllowsTransparency="True" StaysOpen="False" Focusable="False">
                                <Border Background="{DynamicResource ContextMenuBackground}"
                                        BorderBrush="{DynamicResource MenuBorderColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="4">
                                    <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel" WrapWidth="240"
                                                          KeyboardNavigation.TabNavigation="Cycle"
                                                          KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                            <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True"/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <DockPanel LastChildFill="True" Background="Transparent">
        <!-- 全屏时，Visibility 会变为 Collapsed，释放顶部 42 像素空间 -->
        <ui:TitleBar 
            DockPanel.Dock="Top" 
            Height="42" 
            Padding="0"
            HorizontalContentAlignment="Stretch"
            Visibility="{Binding IsFullScreen, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <ui:TitleBar.CenterContent>
                <Grid Margin="12,0,0,0" HorizontalAlignment="Stretch"><!-- 不设 Background：空白区落到原生标题栏(NC)，由系统处理拖动/双击最大化 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding VmName}"
           MaxWidth="140" TextTrimming="CharacterEllipsis" ToolTip="{Binding VmName}"
           VerticalAlignment="Center"
           Margin="0,0,16,0"
           FontSize="12"
           FontWeight="SemiBold"
           MouseLeftButtonDown="OnHeaderMouseLeftButtonDown"
           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/><!-- 文字会接住鼠标 → 显式 DragMove 才能拖窗口（穿透在 ui:TitleBar 里拖不动，对齐 1.4.3） -->

                    <ToolBar x:Name="ConsoleToolbar" Grid.Column="1" Height="32" VerticalAlignment="Center" HorizontalAlignment="Left"
                             Style="{StaticResource ConsoleToolbarStyle}" IsVisibleChanged="OnConsoleToolbarIsVisibleChanged">
                        <Grid VerticalAlignment="Center" ToolBar.OverflowMode="Never">
                            <!-- 启动按钮 -->
                            <ui:Button Icon="{ui:SymbolIcon Symbol=Play24}"
                               Appearance="Transparent" Background="Transparent"
                               Width="60" 
                               Height="32"
                               Padding="0"
                               Command="{Binding StartVmCommand}"
                               ToolTip="{x:Static properties:Resources.ConsoleWindow_StartVm}"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                            <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <ui:Button
                                   Appearance="Transparent" Background="Transparent"
                                   Width="36"
                                   Height="32"
                                   Padding="0"
                                   CornerRadius="4,0,0,4"
                                   Command="{Binding PrimaryPowerCommand}"
                                   ToolTip="{Binding PrimaryPowerText}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="{Binding PrimaryPowerIcon}"/>
                                    </ui:Button.Icon>
                                </ui:Button>

                                <ui:DropDownButton Appearance="Transparent" Background="Transparent"
                                           Width="24"
                                           Height="32"
                                           Padding="0,0,8,0"
                                           Margin="0"
                                           CornerRadius="0,4,4,0"
                                           HorizontalContentAlignment="Center"
                                           IsEnabled="{Binding IsNotBusy}">
                                    <ui:DropDownButton.Flyout>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{x:Static properties:Resources.ConsoleWindow_ShutDown}" Command="{Binding ShutdownVmCommand}"
                                                      Visibility="{Binding IsSavePowerAction, Converter={StaticResource BoolToVis}}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Power24"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{x:Static properties:Resources.ConsoleWindow_Restart}" Command="{Binding ResetVmCommand}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="ArrowSync24"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{x:Static properties:Resources.ConsoleWindow_Pause}" Command="{Binding PauseVmCommand}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Pause24"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{x:Static properties:Resources.ConsoleWindow_SaveState}" Command="{Binding SaveVmCommand}"
                                                      Visibility="{Binding IsSavePowerAction, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Save24"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="{x:Static properties:Resources.ConsoleWindow_TurnOff}" Foreground="#FF4D4F" Command="{Binding TurnOffVmCommand}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Power24" Foreground="#FF4D4F"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </ui:DropDownButton.Flyout>
                                </ui:DropDownButton>

                            </StackPanel>
                        </Grid>

                        <ui:DropDownButton Content="{Binding SelectedResolution}" 
                                   Click="OnConsolePickerClick"
                                   Style="{StaticResource {x:Type ui:DropDownButton}}"
                                   Icon="{ui:SymbolIcon Symbol=Desktop24}" 
                                   Appearance="Transparent" Background="Transparent" 
                                   FontSize="16" 
                                   Height="32"
                                   Padding="8,0" 
                                   Margin="8,0,0,0"
                                   IsEnabled="{Binding CanChangeResolution}">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" ItemsSource="{Binding Resolutions}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding}" />
                                            <Setter Property="Command" Value="{Binding DataContext.ChangeResolutionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>

                        <!-- 缩放下拉：仅基本会话显示（增强会话画面原生跟随窗口、缩放无意义）。放大是拉伸、会糊。 -->
                        <ui:DropDownButton Content="{Binding SelectedZoom}"
                                   Click="OnConsolePickerClick"
                                   Style="{StaticResource {x:Type ui:DropDownButton}}"
                                   Icon="{ui:SymbolIcon Symbol=ZoomIn24}"
                                   Appearance="Transparent" Background="Transparent"
                                   FontSize="16"
                                   Height="32"
                                   Padding="8,0"
                                   Margin="8,0,0,0"
                                   ToolTip="{x:Static properties:Resources.ConsoleWindow_ZoomHint}"
                                   Visibility="{Binding IsEnhancedMode, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" ItemsSource="{Binding ZoomOptions}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding}" />
                                            <Setter Property="Command" Value="{Binding DataContext.ChangeZoomCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>

                        <ui:DropDownButton Content="{Binding SelectedSessionMode}"
                           Click="OnConsolePickerClick"
                           Style="{StaticResource {x:Type ui:DropDownButton}}"
                           Appearance="Transparent" Background="Transparent" 
                           FontSize="16"
                           Height="32"
                           Padding="8,0"
                           Margin="8,0,0,0">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{x:Static properties:Resources.ConsoleViewModel_BasicSession}" Command="{Binding SwitchSessionModeCommand}" CommandParameter="{x:Static properties:Resources.ConsoleViewModel_BasicSession}" />
                                    <MenuItem Header="{x:Static properties:Resources.ConsoleViewModel_EnhancedSession}" Command="{Binding SwitchSessionModeCommand}" CommandParameter="{x:Static properties:Resources.ConsoleViewModel_EnhancedSession}" IsEnabled="{Binding IsEnhancedAvailable}" />
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>

                        <!-- 保留原显示规则：CAD 按钮仅基本会话显示，调用 Core 的虚拟硬件键盘。 -->
                        <ui:Button Icon="{ui:SymbolIcon Symbol=Keyboard24}"
                                   Appearance="Transparent" Background="Transparent"
                                   Style="{StaticResource {x:Type ui:Button}}"
                                   Width="38"
                                   Height="32"
                                   FontSize="16"
                                   Padding="0"
                                   Margin="8,0,0,0"
                                   Command="{Binding SendCadCommand}"
                                   ToolTip="{x:Static properties:Resources.ConsoleWindow_SendCtrlAltDel}"
                                   Visibility="{Binding IsEnhancedMode, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                        
                        <ToggleButton Content="FPS" Height="32" Padding="8,0" Margin="8,0,0,0"
                                      IsChecked="{Binding ShowFrameStatistics, Mode=TwoWay}"
                                      ToolTip="{x:Static properties:Resources.ConsoleWindow_FrameStatisticsHint}"
                                      AutomationProperties.Name="{x:Static properties:Resources.ConsoleWindow_FrameStatistics}"/>

                        <!-- 全屏切换按钮 -->
                        <ui:Button Icon="{ui:SymbolIcon Symbol=FullScreenMaximize24}"
                                   Style="{StaticResource {x:Type ui:Button}}"
                                   Appearance="Transparent" Background="Transparent"
                                   Height="32"
                                   Padding="8,0"
                                   Margin="8,0,0,0"
                                   Command="{Binding ToggleFullScreenCommand}"
                                   ToolTip="{x:Static properties:Resources.ConsoleWindow_FullScreen}" />
                    </ToolBar>
                </Grid>
            </ui:TitleBar.CenterContent>
        </ui:TitleBar>

        <!-- Core 图像流由 WPF 适配器显示，未连接时保留黑底。 -->
        <Grid x:Name="RdpArea" Background="#FF000000">
            <controls:RdpClientHost x:Name="RdpHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    ShowFrameStatistics="{Binding ShowFrameStatistics}"/>
            <Border VerticalAlignment="Bottom" Background="#EE202020" Padding="12,8" Panel.ZIndex="2"
                    Visibility="{Binding HasStateQueryError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StateQueryError}" Foreground="#FFFFD37A" TextWrapping="Wrap"/>
            </Border>
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Background="#EE202020"
                    CornerRadius="0,0,6,6" Padding="8,2" Panel.ZIndex="1"
                    Visibility="{Binding IsFullScreen, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding VmName}" Foreground="White" VerticalAlignment="Center" Margin="4,0,16,0" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                    <ToggleButton Content="FPS" Height="30" Padding="8,0" Margin="0,0,8,0"
                                  IsChecked="{Binding ShowFrameStatistics, Mode=TwoWay}"
                                  ToolTip="{x:Static properties:Resources.ConsoleWindow_FrameStatisticsHint}"
                                  AutomationProperties.Name="{x:Static properties:Resources.ConsoleWindow_FrameStatistics}"/>
                    <ui:Button Icon="{ui:SymbolIcon Symbol=FullScreenMinimize24}" Width="36" Height="30" Padding="0"
                               Appearance="Transparent" Foreground="White" Click="OnExitFullScreenClick"
                               ToolTip="Ctrl+Alt+Enter"/>
                    <ui:Button Content="—" Width="36" Height="30" Padding="0" Appearance="Transparent" Foreground="White" Click="OnMinimizeConsoleClick"/>
                    <ui:Button Content="✕" Width="36" Height="30" Padding="0" Appearance="Transparent" Foreground="White" Click="OnCloseConsoleClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
