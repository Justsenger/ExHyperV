<Page x:Class="ExHyperV.App.UI.Pages.Host.HostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ExHyperV.App.UI.Shared.Controls"
    xmlns:feedback="using:ExHyperV.App.UI.Shared.Feedback"
    KeyboardAcceleratorPlacementMode="Hidden">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="OuterGrid" Margin="12">
        <Border x:Name="OuterFrame" Background="{ThemeResource VmSurfaceBrush}" BorderBrush="{ThemeResource VmStrokeBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <controls:UnderlineTabs x:Name="PageTabs" Grid.Row="0" Margin="16,10,16,8"/>

                <Grid x:Name="ContentArea" Grid.Row="1">
                    <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" VerticalAlignment="Top" Margin="16,0,16,0"/>
                    <Grid x:Name="TabBodyHost" Visibility="Collapsed"/>

                    <feedback:FloatingSuccessToast x:Name="OverlaySuccessToast" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                 MaxWidth="780" Margin="20,0,20,18" Visibility="Collapsed"/>
                    <feedback:FloatingNoticeBanner x:Name="HostNoticeBanner" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                                 MaxWidth="780" Margin="20,0,20,16" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
