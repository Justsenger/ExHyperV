<Page x:Class="ExHyperV.App.UI.Pages.Host.HostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ExHyperV.App.UI.Shared.Controls"
    xmlns:feedback="using:ExHyperV.App.UI.Shared.Feedback"
    KeyboardAcceleratorPlacementMode="Hidden">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <Style x:Key="HostBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource VmBadgeBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource VmStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="9,4"/>
        </Style>
        <Style x:Key="HostBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="12">
        <Border Background="{ThemeResource VmSurfaceBrush}" BorderBrush="{ThemeResource VmStrokeBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部摘要卡片（compact-2row） -->
                <Border Margin="16,12,16,0" Padding="18,12" CornerRadius="8"
                        Background="{ThemeResource VmSummaryBrush}" BorderBrush="{ThemeResource VmStrokeBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="52" Height="52" CornerRadius="8" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource VmStrokeBrush}" BorderThickness="1">
                            <FontIcon Glyph="&#xE770;" FontSize="24" Foreground="{ThemeResource VmAccentBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="HostNameText" Grid.Column="0" FontSize="22" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <controls:WrapPanel x:Name="SummaryBadgesPanel" Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Border Style="{StaticResource HostBadgeStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="12"/>
                                            <TextBlock x:Name="ArchBadgeText" Style="{StaticResource HostBadgeText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="VmCountBadge" Style="{StaticResource HostBadgeStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE770;" FontSize="12"/>
                                            <TextBlock x:Name="VmCountBadgeText" Style="{StaticResource HostBadgeText}" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="VirtBadge" Style="{StaticResource HostBadgeStyle}" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon x:Name="VirtBadgeIcon" Glyph="&#xE73E;" FontSize="12"/>
                                            <TextBlock x:Name="VirtBadgeText" Style="{StaticResource HostBadgeText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="IommuBadge" Style="{StaticResource HostBadgeStyle}" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon x:Name="IommuBadgeIcon" Glyph="&#xE950;" FontSize="12"/>
                                            <TextBlock x:Name="IommuBadgeText" Style="{StaticResource HostBadgeText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="SchedulerBadge" Style="{StaticResource HostBadgeStyle}" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xEA86;" FontSize="12"/>
                                            <TextBlock x:Name="SchedulerBadgeText" Style="{StaticResource HostBadgeText}"/>
                                        </StackPanel>
                                    </Border>
                                </controls:WrapPanel>

                                <Button x:Name="HyperVStatusButton" Grid.Column="2" Height="30" Padding="12,0" CornerRadius="4"
                                        VerticalAlignment="Center" Click="OnHyperVStatusButtonClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon x:Name="HyperVStatusIcon" Glyph="&#xE73E;" FontSize="12"/>
                                        <TextBlock x:Name="HyperVStatusText" FontSize="12.5"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="OsCaptionText" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock x:Name="UptimeSubtitleText" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <controls:UnderlineTabs x:Name="PageTabs" Grid.Row="1" Margin="16,10,16,8"/>

                <!-- 主体区域 -->
                <Grid x:Name="ContentArea" Grid.Row="2">
                    <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" VerticalAlignment="Top" Margin="16,0,16,0"/>
                    <Grid x:Name="TabBodyHost" Visibility="Collapsed"/>

                    <feedback:FloatingSuccessToast x:Name="OverlaySuccessToast" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                 MaxWidth="780" Margin="20,0,20,18" Visibility="Collapsed"/>
                    <feedback:FloatingNoticeBanner x:Name="HostNoticeBanner" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                                 MaxWidth="780" Margin="20,0,20,16" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
