<Window
    x:Class="ExHyperV.App.UI.Pages.VirtualMachines.Console.ConsoleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ExHyperV.App.UI.Pages.VirtualMachines.Console">
    <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
    <Grid x:Name="Root" PreviewKeyDown="OnRootKeyDown">
        <Grid.Resources>
            <SolidColorBrush x:Key="SubtleButtonForegroundPointerOver" Color="White"/>
            <SolidColorBrush x:Key="SubtleButtonForegroundPressed" Color="White"/>
            <SolidColorBrush x:Key="SubtleButtonForegroundDisabled" Color="#62FFFFFF"/>
            <Style x:Key="Tool" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style x:Key="Regular" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>
            <Style x:Key="Filled" TargetType="FontIcon" BasedOn="{StaticResource Regular}">
                <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/FluentSystemIcons-Filled.ttf#FluentSystemIcons-Filled"/>
            </Style>
            <Style x:Key="Caret" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="Glyph" Value="&#xE70D;"/>
            </Style>
            <Style x:Key="SegoeIcon" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="TitleStrip" Height="40" Background="#AD202020" Padding="6,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/><ColumnDefinition x:Name="CaptionInset" Width="138"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="Switcher" Height="28" MinHeight="0" MinWidth="96" MaxWidth="248" Padding="7,0"
                    HorizontalContentAlignment="Stretch" CornerRadius="5" Foreground="White" Background="#24FFFFFF" Click="OnSwitcher">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/></Grid.ColumnDefinitions>
                    <Image x:Name="SwitchIcon" Width="16" Height="16"/>
                    <TextBlock Grid.Column="1" x:Name="SwitchName" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <FontIcon Grid.Column="2" Style="{StaticResource Caret}"/>
                </Grid>
            </Button>
            <Border Grid.Column="1" Width="1" Height="16" Margin="2,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Width="48">
                    <Button x:Name="Power" Style="{StaticResource Tool}" Width="30" Click="OnPrimaryPower"><FontIcon x:Name="PowerIcon" Style="{StaticResource Regular}"/></Button>
                    <Button x:Name="PowerDrop" Style="{StaticResource Tool}" Width="18" Click="OnPowerMenu"><FontIcon Style="{StaticResource Caret}"/></Button>
                </StackPanel>
                <Button x:Name="Resolution" Style="{StaticResource Tool}" Padding="5,0" Click="OnResolutionMenu">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <FontIcon Style="{StaticResource Regular}" Glyph="&#xEB26;"/>
                        <TextBlock x:Name="ResolutionLabel" Width="66" TextAlignment="Center" FontSize="12" Typography.NumeralAlignment="Tabular"/>
                        <FontIcon Style="{StaticResource Caret}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="Zoom" Style="{StaticResource Tool}" Padding="5,0" Click="OnZoomMenu">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <FontIcon Style="{StaticResource Regular}" Glyph="&#xF8C5;"/>
                        <TextBlock x:Name="ZoomLabel" Width="36" TextAlignment="Center" FontSize="12" Typography.NumeralAlignment="Tabular"/>
                        <FontIcon Style="{StaticResource Caret}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SessionMode" Style="{StaticResource Tool}" Padding="6,0" Click="OnSessionModeMenu">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock x:Name="SessionModeLabel" MinWidth="48" TextAlignment="Center" FontSize="12"/>
                        <FontIcon Style="{StaticResource Caret}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="Audio" Style="{StaticResource Tool}" Width="28" Click="OnMute"><FontIcon x:Name="AudioIcon" Style="{StaticResource Regular}"/></Button>
                <Button x:Name="Mic" Style="{StaticResource Tool}" Width="28" Click="OnMicToggle"><FontIcon x:Name="MicIcon" Style="{StaticResource SegoeIcon}" Glyph="&#xF781;"/></Button>
                <Button x:Name="Sas" Style="{StaticResource Tool}" Width="28" Click="OnSas"><FontIcon Style="{StaticResource Filled}" Glyph="&#xF4C3;"/></Button>
                <Button x:Name="Screenshot" Style="{StaticResource Tool}" Width="28" Click="OnScreenshot"><FontIcon Style="{StaticResource Regular}" Glyph="&#xF331;"/></Button>
                <Button x:Name="Fullscreen" Style="{StaticResource Tool}" Width="28" Click="OnFullscreen"><FontIcon x:Name="FullscreenIcon" Style="{StaticResource Regular}"/></Button>
            </StackPanel>
            <Grid Grid.Column="3" x:Name="DragSpace" Background="Transparent"/>
        </Grid>
        <Grid Grid.Row="1" x:Name="Viewport" Background="#0D0D0D" SizeChanged="OnViewportSizeChanged">
            <ScrollViewer x:Name="Scroll" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" ZoomMode="Disabled">
                <local:ConsoleSurface x:Name="Surface" IsTabStop="True" UseSystemFocusVisuals="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" GotFocus="OnSurfaceFocus" LostFocus="OnSurfaceBlur"
                             PointerEntered="OnPointerEntered" PointerPressed="OnPointerPressed" PointerMoved="OnPointerMoved" PointerReleased="OnPointerReleased"
                             PointerCaptureLost="OnCaptureLost" PreviewKeyDown="OnGuestKeyDown" PreviewKeyUp="OnGuestKeyUp">
                    <Grid Background="Transparent">
                        <SwapChainPanel x:Name="GpuScreen" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Image x:Name="Screen" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Canvas IsHitTestVisible="False">
                            <Canvas.Clip><RectangleGeometry x:Name="CursorClip"/></Canvas.Clip>
                            <Image x:Name="RemoteCursor" Stretch="Fill" Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>
                </local:ConsoleSurface>
            </ScrollViewer>
            <Grid x:Name="Overlay" Background="#0D0D0D" Padding="24">
                <Border x:Name="StateCard" MaxWidth="340" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="24,22"
                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <Image x:Name="StateIcon" Width="48" Height="48"/>
                        <TextBlock x:Name="StateTitle" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock x:Name="StateHint" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ContentControl x:Name="ExtensionDetails" Visibility="Collapsed" HorizontalContentAlignment="Stretch"/>
                        <Button x:Name="StateAction" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="OnStateAction"/>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="Connecting" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing x:Name="Spinner" Width="32" Height="32"/>
                    <TextBlock x:Name="ConnectingText" HorizontalAlignment="Center" Foreground="White"/>
                </StackPanel>
            </Grid>
            <Border x:Name="AccessBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,3"
                    Background="#DF222222" CornerRadius="5" IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="AccessText" Foreground="White" FontSize="12"/>
            </Border>
            <Border x:Name="Notice" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12,12" Padding="14,6"
                    CornerRadius="16" Background="#EF222222" IsHitTestVisible="False">
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="12" Foreground="White"/>
            </Border>
            <Border x:Name="Capsule" Visibility="Collapsed" Height="34" Padding="8,0" Margin="0" VerticalAlignment="Top"
                    HorizontalAlignment="Center" CornerRadius="0,0,8,8" BorderThickness="1,0,1,1" BorderBrush="#28FFFFFF" Background="#EB222222">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="Pin" Style="{StaticResource Tool}" Height="31" Width="30" CornerRadius="0,0,5,5" VerticalAlignment="Top" Click="OnPin"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE718;" FontSize="15"/></Button>
                    <TextBlock x:Name="CapsuleName" Foreground="White" FontSize="12.5" FontWeight="SemiBold" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,0,2"/>
                    <Border Width="1" Height="16" Margin="0,0,0,2" Background="#44FFFFFF"/>
                    <Button x:Name="CapsuleSas" Style="{StaticResource Tool}" Height="31" Padding="8,0" CornerRadius="0,0,5,5" VerticalAlignment="Top" Click="OnSas">
                        <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Style="{StaticResource Filled}" Glyph="&#xF4C3;"/><TextBlock x:Name="SasLabel" FontSize="12"/></StackPanel>
                    </Button>
                    <Button x:Name="CapsuleMode" Style="{StaticResource Tool}" Height="31" Padding="8,0" CornerRadius="0,0,5,5" VerticalAlignment="Top" Click="OnCapsuleModeToggle">
                        <TextBlock x:Name="CapsuleModeLabel" FontSize="12"/>
                    </Button>
                    <Button x:Name="LeaveFullscreen" Style="{StaticResource Tool}" Height="31" Padding="8,0" CornerRadius="0,0,5,5" VerticalAlignment="Top" Click="OnFullscreen">
                        <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Style="{StaticResource Regular}" Glyph="&#xE688;"/><TextBlock x:Name="ExitLabel" FontSize="12"/></StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
