<Page x:Class="ExHyperV.App.UI.Pages.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32" Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
        <TextBlock x:Name="TitleHeader" Style="{StaticResource PageTitleStyle}" />
        <InfoBar x:Name="SaveError" Severity="Warning" IsOpen="False" IsClosable="True" />
        <InfoBar x:Name="LanguageNotice" Severity="Informational" IsOpen="False" IsClosable="True" />
        <Border Style="{StaticResource SectionBorderStyle}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="20">
                <TextBlock x:Name="LanguageSectionHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="LanguagePicker" SelectionChanged="OnLanguageChanged" MinWidth="220">
                    <ComboBoxItem x:Name="LangSystemItem" Tag="system" />
                    <ComboBoxItem x:Name="LangZhCnItem" Tag="zh-CN" />
                    <ComboBoxItem x:Name="LangEnItem" Tag="en" Content="English" />
                </ComboBox>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SectionBorderStyle}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="20">
                <TextBlock x:Name="AppearanceSectionHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="ThemePicker" SelectionChanged="OnThemeChanged" MinWidth="220">
                    <ComboBoxItem x:Name="ThemeSystemItem" />
                    <ComboBoxItem x:Name="ThemeLightItem" />
                    <ComboBoxItem x:Name="ThemeDarkItem" />
                </ComboBox>
                <ToggleSwitch x:Name="AccentToggle" Toggled="OnAccentToggled" />
                <StackPanel x:Name="ColorControls" Spacing="12">
                    <StackPanel x:Name="ColorSwatches" Orientation="Horizontal" Spacing="8" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CustomColorButton" Click="OnChooseColor">
                            <Button.Flyout>
                                <Flyout x:Name="ColorFlyout">
                                    <StackPanel Spacing="16">
                                        <ColorPicker x:Name="AccentPicker" IsAlphaEnabled="False" IsMoreButtonVisible="True" IsHexInputVisible="True" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                            <Button x:Name="CancelColorButton" Click="OnCancelColor" />
                                            <Button x:Name="ApplyColorButton" Click="OnApplyColor" Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="ResetColorButton" Click="OnResetColor" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="ColorHintText" Style="{StaticResource DescriptionStyle}" />
                <Border Background="{ThemeResource VmHeaderCheckedBrush}" CornerRadius="4" Padding="20,16">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ExpandedStateLabel" Foreground="{ThemeResource VmHeaderForegroundBrush}" />
                        <TextBlock x:Name="ColorValue" Grid.Column="1" Foreground="{ThemeResource VmHeaderForegroundBrush}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</Page>
