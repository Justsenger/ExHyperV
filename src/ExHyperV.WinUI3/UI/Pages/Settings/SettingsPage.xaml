<Page x:Class="ExHyperV.WinUI3.UI.Pages.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32" Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
        <TextBlock Text="应用设置" Style="{StaticResource PageTitleStyle}" />
        <InfoBar x:Name="SaveError" Severity="Warning" IsOpen="False" IsClosable="True" />
        <Border Style="{StaticResource SectionBorderStyle}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="20">
                <TextBlock Text="外观" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="ThemePicker" Header="应用主题" SelectionChanged="OnThemeChanged" MinWidth="220">
                    <ComboBoxItem Content="跟随系统" />
                    <ComboBoxItem Content="浅色" />
                    <ComboBoxItem Content="深色" />
                </ComboBox>
                <ToggleSwitch x:Name="AccentToggle" Header="主题色" OnContent="开启" OffContent="关闭" Toggled="OnAccentToggled" />
                <StackPanel x:Name="ColorControls" Spacing="12">
                    <StackPanel x:Name="ColorSwatches" Orientation="Horizontal" Spacing="8" AutomationProperties.Name="常用主题色" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="自定义颜色" Click="OnChooseColor">
                            <Button.Flyout>
                                <Flyout x:Name="ColorFlyout">
                                    <StackPanel Spacing="16">
                                        <ColorPicker x:Name="AccentPicker" IsAlphaEnabled="False" IsMoreButtonVisible="True" IsHexInputVisible="True" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                            <Button Content="取消" Click="OnCancelColor" />
                                            <Button Content="应用" Click="OnApplyColor" Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Content="恢复默认蓝色" Click="OnResetColor" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="展开的监控卡片使用主题色；关闭后使用灰色。" Style="{StaticResource DescriptionStyle}" />
                <Border Background="{ThemeResource VmHeaderCheckedBrush}" CornerRadius="4" Padding="20,16">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="展开状态" Foreground="{ThemeResource VmHeaderForegroundBrush}" />
                        <TextBlock x:Name="ColorValue" Grid.Column="1" Foreground="{ThemeResource VmHeaderForegroundBrush}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</Page>
