<UserControl x:Class="ExHyperV.WinUI3.UI.Pages.VirtualMachines.VmDashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:ExHyperV.WinUI3.UI.Pages.VirtualMachines">
 <UserControl.Resources>
  <Style x:Key="BadgeStyle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource VmBadgeBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource VmStrokeBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="10,6"/></Style>
  <Style x:Key="BadgeText" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </UserControl.Resources>
 <Border Background="{ThemeResource VmSurfaceBrush}" BorderBrush="{ThemeResource VmStrokeBrush}" BorderThickness="1" CornerRadius="8">
  <Grid x:Name="Body" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Margin="24,12,24,0" Padding="24" MinHeight="160" CornerRadius="8" Background="{ThemeResource VmSummaryBrush}" BorderBrush="{ThemeResource VmStrokeBrush}" BorderThickness="1">
    <Grid ColumnSpacing="24">
     <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid Width="120" Height="112" VerticalAlignment="Center">
      <Grid x:Name="SystemIconPanel">
       <FontIcon x:Name="GenericIcon" Glyph="&#xE7F4;" FontSize="72" Opacity="0.7"/>
       <Image x:Name="OsImage" Width="104" Height="104" Stretch="Uniform"/>
      </Grid>
      <Grid x:Name="MonitorPreview" Visibility="Collapsed">
      <Border Width="18" Height="18" Background="#777777" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
      <Border Width="64" Height="5" Background="#999999" CornerRadius="2" VerticalAlignment="Bottom"/>
      <Border Height="90" VerticalAlignment="Top" Background="#141414" BorderBrush="#141414" BorderThickness="5" CornerRadius="6">
        <Border x:Name="PreviewBorder" Visibility="Collapsed" Background="#0B0B0B"><Image x:Name="Preview" Stretch="Uniform"/></Border>
      </Border>
      </Grid>
     </Grid>
     <StackPanel Grid.Column="1" Spacing="0">
      <Grid Margin="0,0,0,4" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="VmName" FontSize="28" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
        <Button x:Name="PowerButton" Height="36" CornerRadius="8" Click="OnPowerClick"><TextBlock x:Name="PowerText"/></Button>
        <DropDownButton x:Name="PowerMenu" Height="36" CornerRadius="0,8,8,0" Padding="8,0" Visibility="Collapsed" AutomationProperties.Name="更多电源操作"><DropDownButton.Flyout><MenuFlyout>
         <MenuFlyoutItem Text="重启" Tag="Restart" Click="OnPowerMenuClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xF140;" FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
         <MenuFlyoutItem Text="暂停" Tag="Suspend" Click="OnPowerMenuClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xF5A2;" FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
         <MenuFlyoutSeparator/>
         <MenuFlyoutItem Text="保存状态" Tag="Save" Click="OnPowerMenuClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xF680;" FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
         <MenuFlyoutItem Text="强制关闭" Tag="TurnOff" Click="OnPowerMenuClick" Foreground="#E81123"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xF60F;" FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Foreground="#E81123"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
        </MenuFlyout></DropDownButton.Flyout></DropDownButton>
       </StackPanel>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,12"><FontIcon Glyph="&#xE9DD;" FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" FontSize="16"/><TextBlock x:Name="StateText" FontSize="14" Margin="0,0,6,0"/><FontIcon Glyph="&#xF827;" FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" FontSize="16"/><TextBlock x:Name="UptimeText" FontSize="14"/></StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
       <Border Style="{StaticResource BadgeStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE81E;" FontSize="14"/><TextBlock x:Name="ConfigText" Style="{StaticResource BadgeText}"/></StackPanel></Border>
       <Border x:Name="GenerationBadge" Style="{StaticResource BadgeStyle}" Visibility="Collapsed"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C8;" FontSize="14"/><TextBlock x:Name="GenerationText" Style="{StaticResource BadgeText}"/></StackPanel></Border>
       <Border x:Name="VersionBadge" Style="{StaticResource BadgeStyle}" Visibility="Collapsed"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE946;" FontSize="14"/><TextBlock x:Name="VersionText" Style="{StaticResource BadgeText}"/></StackPanel></Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
       <Border Style="{StaticResource BadgeStyle}"><TextBlock x:Name="OsText" Style="{StaticResource BadgeText}"/></Border>
       <Border Style="{StaticResource BadgeStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xF211;" FontSize="14"/><TextBlock x:Name="GpuText" Style="{StaticResource BadgeText}" TextTrimming="CharacterEllipsis" MaxWidth="180"/></StackPanel></Border>
       <Border x:Name="IpButton" Tapped="OnCopyIp" Style="{StaticResource BadgeStyle}" ToolTipService.ToolTip="点击复制完整 IP 地址"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE839;" FontSize="14"/><TextBlock x:Name="IpText" FontSize="13"/></StackPanel></Border>
      </StackPanel>
     </StackPanel>
    </Grid>
   </Border>
   <local:VmTabs x:Name="PageTabs" Grid.Row="1" Margin="24,16,24,12"/>
   <InfoBar x:Name="ErrorBar" Grid.Row="2" Margin="24,0,24,8" Severity="Warning" IsClosable="True" Visibility="Collapsed" Closed="OnErrorClosed"/>
   <ScrollViewer x:Name="DashboardScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="24,0,24,24" Spacing="12">
     <ProgressBar x:Name="LoadingBar" IsIndeterminate="True"/>
     <StackPanel x:Name="ResourcesPanel" Spacing="12" Visibility="Collapsed">
      <Border Background="{ThemeResource VmCardBrush}" CornerRadius="8" Padding="12">
       <StackPanel Spacing="12">
        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <local:VmMetricCard x:Name="CpuCard" Title="处理器" Glyph="&#xF58E;" Unit="%"/>
         <local:VmMetricCard x:Name="MemoryCard" Grid.Column="1" Title="内存" Glyph="&#xEEA0;" Unit="GB" SecondUnit="GB"/>
        </Grid>
        <Grid x:Name="ResourceDetails"><Grid x:Name="CoreCharts"/><Grid x:Name="MemoryContent" Visibility="Collapsed"/></Grid>
       </StackPanel>
      </Border>
      <Border Background="{ThemeResource VmCardBrush}" CornerRadius="8" Padding="12">
       <StackPanel Spacing="12">
        <local:VmTabs x:Name="DeviceTabs"/>
        <StackPanel x:Name="GpuPanel" Spacing="12">
         <Grid x:Name="GpuSelectors" ColumnSpacing="8" RowSpacing="8"/>
         <TextBlock x:Name="GpuMessage" Opacity="0.6" TextWrapping="Wrap" Margin="4,0"/>
         <Grid x:Name="GpuCharts" ColumnSpacing="8" RowSpacing="8" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel x:Name="StoragePanel" Spacing="12" Visibility="Collapsed">
         <Grid x:Name="DiskSelectors" ColumnSpacing="8" RowSpacing="8"/>
         <StackPanel x:Name="DiskRows" Spacing="12"/>
        </StackPanel>
        <StackPanel x:Name="NetworkPanel" Spacing="12" Visibility="Collapsed">
         <Grid x:Name="NetworkSelectors" ColumnSpacing="8" RowSpacing="8"/>
         <StackPanel x:Name="NetworkRows" Spacing="12"/>
        </StackPanel>
       </StackPanel>
      </Border>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <Grid x:Name="SettingsArea" Grid.Row="3" Margin="24,0,24,24" Visibility="Collapsed" ColumnSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsNavigationColumn" Width="144"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ListView x:Name="SettingsNavigation" SelectionMode="Single" HorizontalContentAlignment="Stretch" SelectionChanged="OnSettingsSelectionChanged" AutomationProperties.Name="设置分组"/>
    <Grid Grid.Column="1">
     <ContentControl x:Name="SettingsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
     <ProgressBar x:Name="SettingsLoadingBar" Height="2" VerticalAlignment="Top" Margin="24,0,24,0"
         Foreground="{ThemeResource VmAccentBrush}" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False"
         AutomationProperties.Name="正在加载虚拟机设置"/>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</UserControl>
