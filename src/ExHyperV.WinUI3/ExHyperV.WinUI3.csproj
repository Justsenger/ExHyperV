<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ExHyperV.WinUI3</RootNamespace>
    <AssemblyName>ExHyperV</AssemblyName>
    <Version>2.0.0-Alpha</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>en;zh-Hans;zh-CN</SatelliteResourceLanguages>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(Configuration)' != 'Release'">false</SelfContained>

    <AllowedReferenceRelatedFileExtensions>.pdb;.pri;.dll.config;.exe.config</AllowedReferenceRelatedFileExtensions>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);Assets\OperatingSystems\AppIcon.svg</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <IlcTrimMetadata>true</IlcTrimMetadata>
    <StripSymbols>true</StripSymbols>
    <EventSourceSupport>false</EventSourceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>.pri;.dll.config;.exe.config</AllowedReferenceRelatedFileExtensions>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime supplies WindowsAppSDK-VersionInfo.cs to the unpackaged bootstrap initializer. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <ProjectReference Include="..\ExHyperV.Core\ExHyperV.Core.csproj">
      <AdditionalProperties Condition="'$(PublishAot)' == 'true'">ExHyperVConsoleRuntime=$(RuntimeIdentifier)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\AppIcon.ico;Assets\AppIcon.png" />
    <Content Include="Assets\AppIcon.ico;Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="Assets\OperatingSystems\*.svg;Assets\Gpu\*.svg" />
    <Content Include="Assets\OperatingSystems\*.svg;Assets\Gpu\*.svg" Exclude="Assets\OperatingSystems\AppIcon.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="Assets\Fonts\*.ttf;Assets\Fonts\*-LICENSE.txt" />
    <Content Include="Assets\Fonts\*.ttf;Assets\Fonts\*-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ExcludeNotificationProjections" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)"
          Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Microsoft.WindowsAppSDK.Foundation' And $([System.String]::Copy('%(RuntimeCopyLocalItems.Filename)').Contains('Notifications'))" />
    </ItemGroup>
  </Target>
  <Target Name="PrepareNativeDesktopInputs" BeforeTargets="_ComputeIlcCompileInputs" Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <!-- Project-reference satellites do not carry NuGet's resources AssetType. Feed them
           to ILC, so ResourceManager reads their tables directly from the native image. -->
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'ExHyperV.Core.resources.dll'"
          AssetType="resources" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Filename)' == 'WebView2Loader' Or
                     '%(ResolvedFileToPublish.Filename)' == 'Microsoft.Web.WebView2.Core' Or
                     '%(ResolvedFileToPublish.Filename)' == 'Microsoft.Windows.ApplicationModel.Background.UniversalBGTask'" />
    </ItemGroup>
  </Target>
  <!-- Explicit build-time composition; never scan or load arbitrary plugin directories. -->
  <Import Project="$(ProductIntegrationTargets)" Condition="'$(ProductIntegrationTargets)' != ''" />
  <ItemGroup>
    <BrotliResource Include="../../doc/api/FieldHelp.json" LogicalName="ExHyperV.ApiFieldHelp.json.br" Kind="json" />
  </ItemGroup>
  <Import Project="../../tools/winui-publish/CompressedResources.targets" />
</Project>
