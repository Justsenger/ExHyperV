<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>2.0.0-Alpha</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ExHyperV.Core/Infrastructure/Interop/WindowsImageCodec.cs" Link="Infrastructure/WindowsImageCodec.cs" />
    <Compile Include="../ExHyperV.Core/Infrastructure/Interop/NativeComInterface.cs;../ExHyperV.Core/Infrastructure/Interop/NativeComStream.cs" Link="Infrastructure/%(Filename)%(Extension)" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../ExHyperV.Core/ExHyperV.Core.csproj" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../ExHyperV.Core/Contracts/API.md" LogicalName="Core.API.md" />
    <EmbeddedResource Include="../ExHyperV.Core/Contracts/API.json" LogicalName="Core.API.json" />
    <EmbeddedResource Include="Api/Contracts.sha256" LogicalName="Core.Contracts.sha256" Condition="Exists('Api/Contracts.sha256')" />
    <InternalsVisibleTo Include="ExHyperV.Mcp.Tests" />
    <None Update="THIRD-PARTY-NOTICES.txt;licenses/**/*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
