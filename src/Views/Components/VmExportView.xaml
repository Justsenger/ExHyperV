<UserControl x:Class="ExHyperV.Views.VmExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:properties="clr-namespace:ExHyperV.Properties"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,16,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:FontIcon Glyph="&#xE2B4;" FontSize="24" Margin="0,0,12,0"
                             FontFamily="{DynamicResource SystemSegoeFluentIcons}"
                             Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Static properties:Resources.VmExport_Title}" FontSize="20"
                           FontWeight="Regular" VerticalAlignment="Center"
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <ui:Button Grid.Column="1" Appearance="Transparent" Padding="8"
                       IsEnabled="{Binding CanLeaveExport}" Command="{Binding CloseExportCommand}">
                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18"/>
            </ui:Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,12,24,24"
                      VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.VmExport_Destination}" FontSize="14"
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>
                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Margin="0,0,0,32">
                    <Grid Margin="24,16" IsEnabled="{Binding CanConfigureExport}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ExportDestinationPath, Mode=OneWay}" IsReadOnly="True"
                                 MinHeight="36" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                        <ui:Button Grid.Column="1" Content="{x:Static properties:Resources.Button_Browse}"
                                   Command="{Binding BrowseExportFolderCommand}" MinWidth="92"/>
                    </Grid>
                </Border>

                <TextBlock Text="{x:Static properties:Resources.VmExport_Content}" FontSize="14"
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>
                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Margin="0,0,0,12"
                        IsEnabled="{Binding CanConfigureExport}">
                    <StackPanel>
                        <Grid Margin="24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{x:Static properties:Resources.VmExport_Configuration}" FontSize="14"
                                           Margin="0,0,0,4" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Static properties:Resources.VmExport_ConfigurationDescription}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="{ui:ThemeResource CardStrokeColorDefaultBrush}" Margin="24,0"/>
                        <Grid Height="72" Margin="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{x:Static properties:Resources.VmExport_VirtualHardDisks}" FontSize="14"
                                           Margin="0,0,0,4" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Static properties:Resources.VmExport_VirtualHardDisksDescription}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                             IsEnabled="{Binding CanConfigureExportVirtualHardDisks}"
                                             IsChecked="{Binding ExportIncludesVirtualHardDisks, Mode=TwoWay}"/>
                        </Grid>
                        <ui:ListView x:Name="ExportDisksList" Margin="16,0,0,10"
                                     ItemsSource="{Binding ExportVirtualHardDisks}"
                                     IsEnabled="{Binding CanConfigureExportVirtualHardDiskSelection}"
                                     SelectionMode="Multiple"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     PreviewMouseLeftButtonDown="ExportDisksList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="ExportDisksList_PreviewMouseMove"
                                     PreviewMouseLeftButtonUp="ExportDisksList_PreviewMouseLeftButtonUp"
                                     Visibility="{Binding ShowExportVirtualHardDiskSelection, Converter={StaticResource BoolToVis}}">
                            <ui:ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ui:ListViewItem}"
                                       BasedOn="{StaticResource {x:Type ui:ListViewItem}}">
                                    <Setter Property="IsSelected" Value="{Binding IsIncluded, Mode=TwoWay}"/>
                                </Style>
                            </ui:ListView.ItemContainerStyle>
                            <ui:ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ui:FontIcon Grid.Column="0"
                                                         Glyph="&#xEC59;"
                                                         FontFamily="{StaticResource SegoeFluentIcons}"
                                                         FontSize="24"
                                                         VerticalAlignment="Center"
                                                         Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}"
                                                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding ControllerDisplay}"
                                                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                                               Visibility="{Binding HasControllerLocation, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text=" | " Margin="8,0"
                                                               Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                               Visibility="{Binding HasControllerLocation, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding SizeGB, StringFormat='{}{0:F2} GB'}"
                                                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <CheckBox Grid.Column="2"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      IsChecked="{Binding IsIncluded, Mode=TwoWay}"/>
                                    </Grid>
                                </DataTemplate>
                            </ui:ListView.ItemTemplate>
                        </ui:ListView>
                        <Rectangle Height="1" Fill="{ui:ThemeResource CardStrokeColorDefaultBrush}" Margin="24,0"/>
                        <Grid Height="72" Margin="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{x:Static properties:Resources.VmExport_RuntimeState}" FontSize="14"
                                           Margin="0,0,0,4" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Static properties:Resources.VmExport_RuntimeStateDescription}" FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                             IsEnabled="{Binding CanConfigureExportRuntimeState}"
                                             IsChecked="{Binding ExportIncludesRuntimeState, Mode=TwoWay}"/>
                        </Grid>
                        <Rectangle Height="1" Fill="{ui:ThemeResource CardStrokeColorDefaultBrush}" Margin="24,0"/>
                        <Grid Margin="24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{x:Static properties:Resources.VmExport_Checkpoints}" FontSize="14"
                                           Margin="0,0,0,4" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Static properties:Resources.VmExport_CheckpointsDescription}" FontSize="12"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Border Grid.Column="1" Width="142" Height="36" CornerRadius="8"
                                    Margin="0,0,16,0" BorderThickness="1"
                                    Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                    Visibility="{Binding ExportIncludesCheckpoints, Converter={StaticResource BoolToVis}}">
                                <Border.Resources>
                                    <Style x:Key="ExportCheckpointSegmentButton" TargetType="Button">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="MinWidth" Value="70"/>
                                        <Setter Property="Height" Value="32"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Border.Resources>
                                <Grid>
                                    <Border Width="67" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Margin="3,0,0,0" CornerRadius="6"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="0"/>
                                        </Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSingleCheckpointMode}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                     To="69" Duration="0:0:0.18">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                     To="0" Duration="0:0:0.18">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <UniformGrid Columns="2">
                                        <Button Content="{x:Static properties:Resources.VmExport_CheckpointModeAll}"
                                                Command="{Binding SelectAllExportCheckpointsCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ExportCheckpointSegmentButton}">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSingleCheckpointMode}" Value="True">
                                                            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{x:Static properties:Resources.VmExport_CheckpointModeSingle}"
                                                Command="{Binding SelectSingleExportCheckpointCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ExportCheckpointSegmentButton}">
                                                    <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSingleCheckpointMode}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </UniformGrid>
                                </Grid>
                            </Border>

                            <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                             IsEnabled="{Binding HasExportCheckpoints}"
                                             IsChecked="{Binding ExportIncludesCheckpoints, Mode=TwoWay}"/>
                        </Grid>
                        <ui:ListView Margin="24,0,24,16"
                                         ItemsSource="{Binding ExportCheckpoints}"
                                         SelectedItem="{Binding SelectedExportCheckpoint, Mode=TwoWay}"
                                         SelectionMode="Single"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         MaxHeight="240"
                                         Visibility="{Binding IsSingleCheckpointExport, Converter={StaticResource BoolToVis}}">
                            <ui:ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ui:ListViewItem}"
                                       BasedOn="{StaticResource {x:Type ui:ListViewItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ui:ListViewItem}">
                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderThickness="1"
                                                        CornerRadius="{TemplateBinding Border.CornerRadius}">
                                                    <Grid>
                                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                          HorizontalAlignment="Stretch"/>
                                                        <RadioButton HorizontalAlignment="Right"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,20,0"
                                                                     IsHitTestVisible="False"
                                                                     IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                                                        <Rectangle x:Name="ActiveRectangle"
                                                                   Width="3" Height="18"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"
                                                                   Fill="{DynamicResource ListViewItemPillFillBrush}"
                                                                   RadiusX="2" RadiusY="2"
                                                                   Visibility="Collapsed"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsEnabled" Value="True"/>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="ItemBorder" Property="Background"
                                                                Value="{DynamicResource ListViewItemBackgroundPointerOver}"/>
                                                    </MultiTrigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="ItemBorder" Property="Background"
                                                                Value="{DynamicResource ListViewItemBackgroundPointerOver}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ui:ListView.ItemContainerStyle>
                            <ui:ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TreePrefix}"
                                                   FontFamily="Cascadia Mono" Margin="8,0,4,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,72,0">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding CreatedDateDisplay}" Margin="0,2,0,0"
                                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ui:ListView.ItemTemplate>
                        </ui:ListView>
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Static properties:Resources.VmExport_PackageSection}" FontSize="14"
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0,12,0,12"/>
                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Margin="0,0,0,16"
                        IsEnabled="{Binding CanConfigureExport}">
                    <Grid Margin="24,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{x:Static properties:Resources.VmExport_CreatePackage}" FontSize="14"
                                       Margin="0,0,0,4"
                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{x:Static properties:Resources.VmExport_CreatePackageDescription}" FontSize="12"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <Border Grid.Column="1" Width="180" Height="36" CornerRadius="8"
                                Margin="0,0,16,0" BorderThickness="1"
                                Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                Visibility="{Binding ShowExportPackageOptions, Converter={StaticResource BoolToVis}}">
                            <Border.Resources>
                                <Style x:Key="ExportPackageSegmentButton" TargetType="Button">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinWidth" Value="88"/>
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Border.Resources>
                            <Grid>
                                <Border Width="86" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="3,0,0,0" CornerRadius="6"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompressedExportPackage}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                 To="88" Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                 To="0" Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <UniformGrid Columns="2">
                                    <Button Content="{x:Static properties:Resources.VmExport_PackageStore}"
                                            Command="{Binding SelectStoredExportPackageCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ExportPackageSegmentButton}">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompressedExportPackage}" Value="True">
                                                        <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{x:Static properties:Resources.VmExport_PackageCompress}"
                                            Command="{Binding SelectCompressedExportPackageCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ExportPackageSegmentButton}">
                                                <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompressedExportPackage}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                         IsChecked="{Binding ExportCreatesPackage, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0"
                                   Text="{x:Static properties:Resources.VmExport_PackageSpaceWarning}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding ShowExportPackageOptions, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Margin="0,0,0,16"
                        Visibility="{Binding ShowExportProgress, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="24,18">
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{Binding ExportStatusText}" FontSize="13"
                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding ExportProgress, StringFormat={}{0}%}" FontSize="13"
                                       HorizontalAlignment="Right"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ExportProgress}" Height="6"/>
                    </StackPanel>
                </Border>

                <ui:Button Content="{x:Static properties:Resources.VmExport_Start}" Appearance="Primary"
                           HorizontalAlignment="Right" Padding="24,6"
                           IsEnabled="{Binding CanStartExport}" Command="{Binding StartExportCommand}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
