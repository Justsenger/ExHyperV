<UserControl
    x:Class="ExHyperV.Views.VmImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:ExHyperV.Models"
    xmlns:properties="clr-namespace:ExHyperV.Properties"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <Style x:Key="ImportStep0" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VmImportStep}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ImportStep1" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VmImportStep}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PreviewChip" TargetType="Border">
            <Setter Property="Background" Value="{ui:ThemeResource ControlFillColorTertiaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ui:ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,16,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:FontIcon Glyph="&#xE2B3;" FontSize="24" Margin="0,0,12,0"
                             FontFamily="{DynamicResource SystemSegoeFluentIcons}"
                             Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Static properties:Resources.VmImport_Title}" FontSize="20"
                           FontWeight="Regular" VerticalAlignment="Center"
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <ui:Button Grid.Column="1" Appearance="Transparent" Padding="8"
                       IsEnabled="{Binding CanLeaveVmImport}" Command="{Binding BackFromVmImportCommand}">
                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18"/>
            </ui:Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,12,24,88"
                      VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel>

                <StackPanel Style="{StaticResource ImportStep0}">
                    <TextBlock Text="{x:Static properties:Resources.VmImport_Source}" FontSize="14" Margin="0,0,0,12"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                             BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                             CornerRadius="8" Margin="0,0,0,32">
                        <Grid Margin="24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{x:Static properties:Resources.Common_Type}" Margin="0,0,12,8"
                                       FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{x:Static properties:Resources.Common_Path}" Margin="0,0,12,8"
                                       FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox Grid.Row="1" SelectedValue="{Binding VmImportSourceKind, Mode=TwoWay}"
                                      SelectedValuePath="Tag" VerticalAlignment="Stretch" Margin="0,0,12,0">
                                <ComboBoxItem Content="{x:Static properties:Resources.VmImport_SourceFolder}"
                                              Tag="{x:Static models:VmImportSourceKind.Folder}"/>
                                <ComboBoxItem Content="{x:Static properties:Resources.VmImport_SourceArchive}"
                                              Tag="{x:Static models:VmImportSourceKind.Zip}"/>
                            </ComboBox>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding VmImportSourcePath, Mode=OneWay}" IsReadOnly="True"
                                     MinHeight="36" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                            <ui:Button Grid.Row="1" Grid.Column="2" Content="{x:Static properties:Resources.Common_Select}"
                                       Command="{Binding BrowseVmImportSourceCommand}" MinWidth="80"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{x:Static properties:Resources.VmImport_Placement}" FontSize="14" Margin="0,0,0,12"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                             BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                             CornerRadius="8" Margin="0,0,0,16">
                        <ui:ListView SelectionMode="Single" BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ui:ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ui:ListViewItem}"
                                       BasedOn="{StaticResource {x:Type ui:ListViewItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ui:ListViewItem}">
                                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                        BorderThickness="1" CornerRadius="{TemplateBinding Border.CornerRadius}">
                                                    <Grid>
                                                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch"/>
                                                        <Rectangle x:Name="ActiveRectangle" Width="3" Height="18"
                                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                   Fill="{DynamicResource ListViewItemPillFillBrush}"
                                                                   RadiusX="2" RadiusY="2" Visibility="Collapsed"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsEnabled" Value="True"/>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="ItemBorder" Property="Background"
                                                                Value="{DynamicResource ListViewItemBackgroundPointerOver}"/>
                                                    </MultiTrigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="ItemBorder" Property="Background"
                                                                Value="{DynamicResource ListViewItemBackgroundPointerOver}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ui:ListView.ItemContainerStyle>

                            <ui:ListViewItem IsSelected="{Binding VmImportUsesExistingDirectory, Mode=TwoWay, Converter={StaticResource InverseBooleanConverter}}">
                                <Grid Height="72" Margin="24,0">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{x:Static properties:Resources.VmImport_HostDirectories}" FontSize="14" Margin="0,0,0,4"
                                                   Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{x:Static properties:Resources.VmImport_HostDirectoriesDescription}" FontSize="12"
                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Rectangle Height="1" VerticalAlignment="Bottom"
                                               Fill="{ui:ThemeResource CardStrokeColorDefaultBrush}"/>
                                </Grid>
                            </ui:ListViewItem>

                            <ui:ListViewItem Visibility="{Binding IsImportFolderSource, Converter={StaticResource BoolToVis}}"
                                             IsSelected="{Binding VmImportUsesExistingDirectory, Mode=TwoWay}">
                                <Grid Height="72" Margin="24,0">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{x:Static properties:Resources.VmImport_ExistingDirectory}" FontSize="14" Margin="0,0,0,4"
                                                   Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{x:Static properties:Resources.VmImport_ExistingDirectoryDescription}" FontSize="12"
                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </ui:ListViewItem>
                        </ui:ListView>
                    </Border>
                    <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding IsPreparingVmImport, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="24,18">
                            <TextBlock Text="{Binding VmImportStatusText}" FontSize="13" Margin="0,0,0,10"/>
                            <ProgressBar IsIndeterminate="True" Height="6"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Style="{StaticResource ImportStep1}">
                    <TextBlock Text="{x:Static properties:Resources.VmImport_Preview}" FontSize="14" Margin="0,0,0,12"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>

                    <ItemsControl ItemsSource="{Binding VmImportPreviews}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Rectangle Grid.Row="0" Width="3" Height="18"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Fill="{DynamicResource ListViewItemPillFillBrush}"
                                                   RadiusX="2" RadiusY="2"/>
                                    <Grid Grid.Row="0" Margin="24,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Width="72" Height="72" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding OsType, Converter={StaticResource OsTypeToImageConverter}}"/>

                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="22"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>

                                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                                <WrapPanel>
                                                    <Border Style="{StaticResource PreviewChip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:FontIcon Glyph="&#xE81E;" FontSize="14"
                                                                         FontFamily="{DynamicResource SegoeFluentIcons}"
                                                                         Margin="0,1,8,0"
                                                                         Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding ProcessorMemorySummary}" FontSize="13"
                                                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource PreviewChip}">
                                                        <TextBlock Text="{Binding OsType}" FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource PreviewChip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:FontIcon Glyph="&#xE8C8;" FontSize="14"
                                                                         FontFamily="{DynamicResource SegoeFluentIcons}"
                                                                         Margin="0,1,8,0"
                                                                         Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding GenerationText}" FontSize="13"
                                                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource PreviewChip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:FontIcon Glyph="&#xE946;" FontSize="14"
                                                                         FontFamily="{DynamicResource SegoeFluentIcons}"
                                                                         Margin="0,1,8,0"
                                                                         Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                                            <TextBlock FontSize="13"
                                                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
                                                                <Run Text="{x:Static properties:Resources.VmImport_ConfigurationVersion}"/>
                                                                <Run Text=" "/>
                                                                <Run Text="{Binding ConfigurationVersion, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                                <WrapPanel>
                                                    <Border Style="{StaticResource PreviewChip}" Margin="0,0,8,0">
                                                        <TextBlock FontSize="13"
                                                                   Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
                                                            <Run Text="GUID"/>
                                                            <Run Text=" "/>
                                                            <Run Text="{Binding GuidText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Style="{StaticResource PreviewChip}" Margin="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Timer24" FontSize="14" Margin="0,1,8,0"
                                                                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding CreatedText}" FontSize="13"
                                                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>

                                        </Grid>
                                    </Grid>
                                        <Border Grid.Row="1" Margin="24,0,24,16">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                    <Setter Property="Background" Value="{ui:ThemeResource SystemFillColorCriticalBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{ui:ThemeResource SystemFillColorCriticalBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CompatibilityIssues.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ItemsControl ItemsSource="{Binding CompatibilityIssues}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat=• {0}}" FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16" Visibility="{Binding ShowVmImportProgress, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="24,18"><Grid Margin="0,0,0,10"><TextBlock Text="{Binding VmImportStatusText}" FontSize="13"/><TextBlock Text="{Binding VmImportProgress, StringFormat={}{0}%}" FontSize="13" HorizontalAlignment="Right" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding VmImportProgress}" Height="6"/></StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Style="{StaticResource ImportStep0}" Panel.ZIndex="1">
            <ui:Button Content="{x:Static properties:Resources.Button_Next}" Appearance="Primary"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,24,24" Padding="24,6"
                       IsEnabled="{Binding CanPrepareVmImport}" Command="{Binding PrepareVmImportCommand}"/>
        </Grid>
        <Grid Grid.Row="1" Style="{StaticResource ImportStep1}" Panel.ZIndex="1">
            <ui:Button Content="{x:Static properties:Resources.VmImport_Start}" Appearance="Primary"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,24,24" Padding="24,6"
                       IsEnabled="{Binding CanStartVmImport}" Command="{Binding StartVmImportCommand}"/>
        </Grid>
    </Grid>
</UserControl>
