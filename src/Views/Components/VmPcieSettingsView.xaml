<UserControl x:Class="ExHyperV.Views.VmPcieSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:properties="clr-namespace:ExHyperV.Properties"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="PcieRequiredToggleStyle"
               TargetType="ui:ToggleSwitch"
               BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="50"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="ToolTip" Value="{x:Static properties:Resources.Error_VerNotSupport}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.SelectedVm.IsRunning, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="ToolTip" Value="{x:Static properties:Resources.Warn_VmOffRequired}"/>
                </MultiDataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PcieRequiredComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="50"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="ToolTip" Value="{x:Static properties:Resources.Error_VerNotSupport}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.SelectedVm.IsRunning, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="ToolTip" Value="{x:Static properties:Resources.Warn_VmOffRequired}"/>
                </MultiDataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,20,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xF0B9;"
                                 FontFamily="{DynamicResource SegoeFluentIcons}"
                                 FontSize="22"
                                 Margin="0,0,12,0"
                                 Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Static properties:Resources.VmPcie_Title}"
                               FontSize="20"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="{x:Static properties:Resources.VmPcie_Hint}"
                           FontSize="13"
                           Opacity="0.6"
                           Margin="0,6,0,0"
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <ui:Button Grid.Column="1"
                       Appearance="Transparent"
                       Padding="8"
                       Command="{Binding GoBackToDashboardCommand}">
                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="20"/>
            </ui:Button>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Padding="24,4,24,24"
                      VerticalScrollBarVisibility="Auto"
                      PanningMode="VerticalOnly">
            <StackPanel IsEnabled="{Binding IsLoadingSettings, Converter={StaticResource InverseBooleanConverter}}">

                <TextBlock Text="{Binding VmPcieSystemSection}"
                           FontSize="14"
                           Margin="0,0,0,12"
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>

                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,24">
                    <StackPanel>
                        <Grid Margin="24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{Binding VmPcieEmulationTitle}"
                                           FontSize="14"
                                           Margin="0,0,0,4"
                                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding VmPcieEmulationDesc}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             Tag="{Binding PcieSystemSettingsAvailable}"
                                             IsChecked="{Binding PcieEmulationEnabled, Mode=OneWay}"
                                             Command="{Binding EnablePcieEmulationCommand}">
                                <ui:ToggleSwitch.Style>
                                    <Style TargetType="ui:ToggleSwitch"
                                           BasedOn="{StaticResource PcieRequiredToggleStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PcieEmulationEnabled}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:ToggleSwitch.Style>
                            </ui:ToggleSwitch>
                        </Grid>

                        <Rectangle Height="1"
                                   Fill="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                   Margin="24,0"/>

                        <Grid Margin="24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{Binding VmPcieTopologyTitle}"
                                           FontSize="14"
                                           Margin="0,0,0,4"
                                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding VmPcieTopologyDesc}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Width="180"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource PcieRequiredComboBoxStyle}"
                                      Tag="{Binding PcieSystemSettingsAvailable}"
                                      ItemsSource="{Binding PcieTopologyOptions}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedPcieTopology, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <TextBlock Text="{Binding VmPcieBootSection}"
                               FontSize="14"
                               Margin="0,0,0,12"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,24">
                        <Grid Margin="24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{Binding VmPcieBootTitle}"
                                           FontSize="14"
                                           Margin="0,0,0,4"
                                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding VmPcieBootDesc}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             Style="{StaticResource PcieRequiredToggleStyle}"
                                             Tag="{Binding BootPciExpressAvailable}"
                                             IsChecked="{Binding BootPciExpressEnabled, Mode=TwoWay}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding VmPcieDevicesSection}"
                           FontSize="14"
                           Margin="0,0,0,12"
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>

                <TextBlock Text="{Binding VmPcieNoDevices}"
                           Margin="4,4,0,24"
                           FontSize="12"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasNoPcieDevices, Converter={StaticResource BoolToVis}}"/>

                <ItemsControl ItemsSource="{Binding PcieDevices}"
                              Visibility="{Binding HasPcieDevices, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardExpander IsExpanded="False"
                                             Margin="0,0,0,10"
                                             ContentPadding="6">
                                <ui:CardExpander.Icon>
                                    <ui:FontIcon Glyph="{Binding IconGlyph}"
                                                 FontSize="24"
                                                 FontFamily="{DynamicResource SegoeFluentIcons}"/>
                                </ui:CardExpander.Icon>
                                <ui:CardExpander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontSize="16"
                                                   Margin="0,-2,16,0"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,4,0">
                                            <ComboBox Width="220"
                                                      Style="{StaticResource PcieRequiredComboBoxStyle}"
                                                      Tag="{Binding GuestModeAvailable}"
                                                      ItemsSource="{Binding DataContext.PcieGuestModes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding GuestMode, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:CardExpander.Header>

                                <StackPanel Margin="42,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="125"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{x:Static properties:Resources.Label_Class}"
                                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,10,10"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding ClassType}"
                                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,10,10"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{x:Static properties:Resources.Instanceid}"
                                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,10,10"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding DeviceInstanceId}"
                                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,10,10"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Text="{x:Static properties:Resources.Label_Path}"
                                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,10,10"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   Text="{Binding Path}"
                                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,10,10"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0"
                                                   Text="{x:Static properties:Resources.Label_Manufacturer}"
                                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,10,10"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                                   Text="{Binding Vendor}"
                                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,10,10"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </StackPanel>
                            </ui:CardExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
