<Page
    x:Class="ExHyperV.Views.GpuPvPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:ExHyperV.ViewModels"
    xmlns:properties="clr-namespace:ExHyperV.Properties"
    Title="GpuPvPage"
    d:DataContext="{d:DesignInstance vm:GpuPvViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:GpuPvViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <StackPanel Margin="10,0,10,10">
            <ui:InfoBar Margin="0,5,0,0"
                        Title="{x:Static properties:Resources.Common_Attention}"
                        Message="{x:Static properties:Resources.GpuPv_InfoBar_Notice}"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"/>

            <ui:InfoBar Margin="0,5,0,0"
                        Title="{x:Static properties:Resources.GpuPv_NoPartitionableGpu_Title}"
                        Message="{x:Static properties:Resources.GpuPv_NoPartitionableGpu_Message}"
                        IsOpen="{Binding ShowNoPartitionableGpu}"
                        IsClosable="False"
                        Severity="Error"/>

            <Grid Margin="0,5,0,0">
                <ui:Card BorderThickness="1" Padding="10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:FontIcon Glyph="&#xF0B9;" FontSize="24" FontFamily="{DynamicResource SegoeFluentIcons}"/>
                            <TextBlock Text="{x:Static properties:Resources.GpuPv_Section_HostGpus}" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ui:Button HorizontalAlignment="Right"
                                   Content="{x:Static properties:Resources.Btn_Refresh}"
                                   Command="{Binding LoadCommand}"
                                   IsEnabled="{Binding IsUiEnabled}"/>
                    </Grid>
                </ui:Card>
            </Grid>

            <ItemsControl ItemsSource="{Binding HostGpus}" Margin="0,0,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardExpander IsExpanded="False" Margin="20,5,0,0" ContentPadding="6">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon Glyph="&#xF0B9;" FontSize="24" FontFamily="{DynamicResource SegoeFluentIcons}"/>
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="16" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding AssignedDisplay}" FontSize="12" Opacity="0.7"/>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1"
                                               Content="{x:Static properties:Resources.GpuPv_Btn_Assign}"
                                               Margin="10,0,5,0"
                                               IsEnabled="{Binding IsPartitionable}"
                                               Command="{Binding DataContext.AssignCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"/>
                                </Grid>
                            </ui:CardExpander.Header>

                            <StackPanel Margin="42,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static properties:Resources.GpuPv_Label_Manu}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Manu}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static properties:Resources.GpuPv_Label_Vendor}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Vendor}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,8" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static properties:Resources.GpuPv_Label_DriverVersion}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DriverVersion}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static properties:Resources.GpuPv_Label_MemoryPath}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,8" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding MemoryDisplay, Mode=OneWay}"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="{Binding PathDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="{x:Static properties:Resources.GpuPv_NotPartitionable_Hint}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding IsNotPartitionable, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ui:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,15,0,0">
                <ui:Card BorderThickness="1" Padding="10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:FontIcon Glyph="&#xE7F8;" FontSize="24" FontFamily="{DynamicResource SegoeFluentIcons}"/>
                        <TextBlock Text="{x:Static properties:Resources.GpuPv_Section_Assignments}" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <ItemsControl ItemsSource="{Binding Assignments}" Margin="0,0,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardExpander IsExpanded="False" Margin="20,5,0,0" ContentPadding="6">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon Glyph="&#xE7F8;" FontSize="24" FontFamily="{DynamicResource SegoeFluentIcons}"/>
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding VmName}" FontSize="16" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding GpuName}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ui:Button Content="{x:Static properties:Resources.GpuPv_Btn_SyncDriver}"
                                                   Margin="10,0,5,0"
                                                   IsEnabled="{Binding DataContext.IsUiEnabled, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   Command="{Binding DataContext.SyncDriverCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"/>
                                        <ui:Button Content="{x:Static properties:Resources.GpuPv_Btn_CleanupDriver}"
                                                   Margin="0,0,5,0"
                                                   IsEnabled="{Binding DataContext.IsUiEnabled, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   Command="{Binding DataContext.CleanupDriverCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"/>
                                        <ui:Button Content="{x:Static properties:Resources.GpuPv_Btn_Remove}"
                                                   IsEnabled="{Binding DataContext.IsUiEnabled, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </ui:CardExpander.Header>

                            <StackPanel Margin="42,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static properties:Resources.GpuPv_Label_Manu}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Manu}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static properties:Resources.GpuPv_Label_DriverVersion}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DriverVersion}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static properties:Resources.GpuPv_Label_Memory}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MemoryDisplay}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static properties:Resources.GpuPv_Label_InstancePath}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InstancePath}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,8" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding ShowVmMaintenance, Converter={StaticResource BoolToVis}}">
                                    <ui:Button Content="{x:Static properties:Resources.GpuPv_Btn_MmioCheck}"
                                               Margin="0,0,8,0"
                                               IsEnabled="{Binding DataContext.IsUiEnabled, RelativeSource={RelativeSource AncestorType=Page}}"
                                               Command="{Binding DataContext.MmioCheckCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"/>
                                    <ui:Button Content="{x:Static properties:Resources.GpuPv_Btn_Repair}"
                                               IsEnabled="{Binding DataContext.IsUiEnabled, RelativeSource={RelativeSource AncestorType=Page}}"
                                               Command="{Binding DataContext.RepairCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ProgressBar Panel.ZIndex="1" VerticalAlignment="Top" Height="4"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <Grid Panel.ZIndex="2" Background="#99000000"
              Visibility="{Binding IsDriverBusy, Converter={StaticResource BoolToVis}}">
            <ui:Card MaxWidth="640" MaxHeight="460" Padding="16" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding DriverTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <ProgressBar Grid.Row="1" Height="4" Margin="0,12,0,8" IsIndeterminate="True"/>
                    <TextBlock Grid.Row="2" Text="{Binding DriverStatus}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBox Grid.Row="3" Text="{Binding DriverLog, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             Height="180"
                             FontFamily="Consolas"
                             FontSize="12"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                    <ui:Button Grid.Row="4"
                               Content="{x:Static properties:Resources.GpuPv_Btn_Close}"
                               HorizontalAlignment="Right"
                               Margin="0,12,0,0"
                               IsEnabled="{Binding DriverCanClose}"
                               Command="{Binding CloseDriverOverlayCommand}"/>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
