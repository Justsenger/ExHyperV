<Page
    x:Class="ExHyperV.Views.HostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:ExHyperV.Converters"
    xmlns:properties="clr-namespace:ExHyperV.Properties"
    Title="HostPage">

    <Page.Resources>
        <Style x:Key="HostPageTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Border Height="1"
                                        VerticalAlignment="Bottom"
                                        Background="{ui:ThemeResource CardStrokeColorDefaultBrush}"/>
                                <TabPanel Margin="0"
                                          Panel.ZIndex="1"
                                          Background="Transparent"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"/>
                            </Grid>
                            <ContentPresenter Grid.Row="1"
                                              Margin="0"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              ContentSource="SelectedContent"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HostPageTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid>
                            <Border x:Name="HeaderBackground"
                                    Margin="0,0,4,0"
                                    Padding="14,10"
                                    Background="Transparent"
                                    CornerRadius="6,6,0,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <Border x:Name="SelectionIndicator"
                                    Height="3"
                                    Margin="14,0,18,0"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="2"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBackground" Property="Background" Value="{ui:ThemeResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBackground" Property="Background" Value="{ui:ThemeResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                <Setter Property="Panel.ZIndex" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <StackPanel>
            <StackPanel Margin="0,0,0,12">
                <ui:TextBlock Text="{x:Static properties:Resources.Menu_Env}" FontSize="28" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>

            <TabControl Style="{StaticResource HostPageTabControlStyle}">
                <TabItem Header="{x:Static properties:Resources.HostPage_EnvironmentTab}"
                         Style="{StaticResource HostPageTabItemStyle}"
                         IsSelected="True">
                    <StackPanel Margin="0,16,0,16">
                <ui:TextBlock Text="{x:Static properties:Resources.Label_ReqGeneral}"
                              Margin="0,0,0,8"
                              Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>

                <!-- CPU 虚拟化 -->
                <ui:Card Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True"
                                             Visibility="{Binding CpuStatus.IsChecking, Converter={StaticResource BoolToVis}}"/>
                            <ui:FontIcon FontSize="20" FontFamily="{DynamicResource SegoeFluentIcons}"
                                         Glyph="{Binding CpuStatus.IconGlyph}"
                                         Foreground="{Binding CpuStatus.IconColor}"
                                         Visibility="{Binding CpuStatus.IsChecking, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Static properties:Resources.Menu_CpuVirt}" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                </ui:Card>

                <!-- Hyper-V 服务 -->
                <ui:Card Padding="16,10" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True"
                                             Visibility="{Binding HyperVStatus.IsChecking, Converter={StaticResource BoolToVis}}"/>
                            <ui:FontIcon FontSize="20" FontFamily="{DynamicResource SegoeFluentIcons}"
                                         Glyph="{Binding HyperVStatus.IconGlyph}"
                                         Foreground="{Binding HyperVStatus.IconColor}"
                                         Visibility="{Binding HyperVStatus.IsChecking, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static properties:Resources.Menu_HyperVService}" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding HyperVStatus.StatusText}"
                                       Visibility="{Binding HyperVStatus.StatusText, Converter={StaticResource StringToVisibilityConverter}}"
                                       FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="{x:Static properties:Resources.Button_Enable}" Appearance="Primary"
                                       Visibility="{Binding HyperVStatus.IsSuccess, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                       Command="{Binding EnableHyperVCommand}"/>
                            <ui:Button Content="{x:Static properties:Resources.HostPage_Disable}" Appearance="Secondary"
                                       Visibility="{Binding HyperVStatus.IsSuccess, Converter={StaticResource BoolToVis}}"
                                       Command="{Binding DisableHyperVCommand}"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- GPU-PV 要求 -->
                <ui:TextBlock Text="{x:Static properties:Resources.Label_ReqGpuPv}"
                              Margin="0,16,0,8"
                              Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>

                <!-- 系统版本 -->
                <ui:Card Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True"
                                             Visibility="{Binding VersionStatus.IsChecking, Converter={StaticResource BoolToVis}}"/>
                            <ui:FontIcon FontSize="20" FontFamily="{DynamicResource SegoeFluentIcons}"
                                         Glyph="{Binding VersionStatus.IconGlyph}"
                                         Foreground="{Binding VersionStatus.IconColor}"
                                         Visibility="{Binding VersionStatus.IsChecking, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14">
                            <Run Text="{x:Static properties:Resources.Label_SysVer}" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                            <Run Text="{Binding VersionStatus.StatusText}" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                        </TextBlock>
                    </Grid>
                </ui:Card>

                <!-- PCIe 直通要求（仅 DDA 需要） -->
                <ui:TextBlock Text="{x:Static properties:Resources.Label_ReqPcie}"
                              Margin="0,16,0,8"
                              Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>

                <!-- IOMMU / SMMU（x86=IOMMU，ARM=SMMU，IommuLabel 按架构切换） -->
                <ui:Card Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True"
                                             Visibility="{Binding IommuStatus.IsChecking, Converter={StaticResource BoolToVis}}"/>
                            <ui:FontIcon FontSize="20" FontFamily="{DynamicResource SegoeFluentIcons}"
                                         Glyph="{Binding IommuStatus.IconGlyph}"
                                         Foreground="{Binding IommuStatus.IconColor}"
                                         Visibility="{Binding IommuStatus.IsChecking, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding IommuLabel}" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                </ui:Card>

                <!-- 属于 Windows Server 系统 -->
                <ui:Card Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True"
                                             Visibility="{Binding SystemStatus.IsChecking, Converter={StaticResource BoolToVis}}"/>
                            <ui:FontIcon FontSize="20" FontFamily="{DynamicResource SegoeFluentIcons}"
                                         Glyph="{Binding SystemStatus.IconGlyph}"
                                         Foreground="{Binding SystemStatus.IconColor}"
                                         Visibility="{Binding SystemStatus.IsChecking, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Static properties:Resources.Label_ServerSys}" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                </ui:Card>

                <!-- USB 直通要求（仅检测主机侧） -->
                <ui:TextBlock Text="{x:Static properties:Resources.Label_ReqUsb}"
                              Margin="0,16,0,8"
                              Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>

                <!-- usbipd-win -->
                <ui:Card Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True"
                                             Visibility="{Binding UsbStatus.IsChecking, Converter={StaticResource BoolToVis}}"/>
                            <ui:FontIcon FontSize="20" FontFamily="{DynamicResource SegoeFluentIcons}"
                                         Glyph="{Binding UsbStatus.IconGlyph}"
                                         Foreground="{Binding UsbStatus.IconColor}"
                                         Visibility="{Binding UsbStatus.IsChecking, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Static properties:Resources.Label_UsbipdInstalled}" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                </ui:Card>
                    </StackPanel>
                </TabItem>

                <TabItem Header="{x:Static properties:Resources.HostPage_GeneralTab}"
                         Style="{StaticResource HostPageTabItemStyle}">
                    <StackPanel Margin="0,16,0,16">

                <!-- 主机当前使用的 Windows 电源方案。仅枚举现有方案，不创建或修改方案内容。 -->
                <ui:CardControl Margin="0,0,0,8" Padding="12">
                    <ui:CardControl.Icon>
                        <ui:FontIcon FontSize="22" FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xEC4A;"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <TextBlock Text="{x:Static properties:Resources.Menu_HostPowerPlan}" FontSize="14" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    </ui:CardControl.Header>

                    <ComboBox Width="140"
                              ItemsSource="{Binding PowerPlans}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding CurrentPowerPlanId, Mode=TwoWay}"/>
                </ui:CardControl>

                <!-- 核心调度器 -->
                <ui:CardControl Margin="0,0,0,8" Padding="12">
                    <ui:CardControl.Icon>
                        <ui:FontIcon FontSize="22" FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xEA86;"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <TextBlock Text="{x:Static properties:Resources.Menu_Scheduler}" FontSize="14" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    </ui:CardControl.Header>

                    <ComboBox Width="140"
                              ItemsSource="{Binding SchedulerModes}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Type"
                              SelectedValue="{Binding CurrentSchedulerType, Mode=TwoWay}">
                    </ComboBox>
                </ui:CardControl>

                <!-- NUMA 跨越 -->
                <ui:CardControl Margin="0,0,0,8" Padding="12">
                    <ui:CardControl.Icon>
                        <ui:FontIcon FontSize="22" FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xF57C;"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static properties:Resources.Menu_NumaSpan}" FontSize="14" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{x:Static properties:Resources.Desc_NumaSpan}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ui:CardControl.Header>

                    <ui:ToggleSwitch IsChecked="{Binding IsNumaSpanningEnabled, Mode=TwoWay}"
                                     IsEnabled="{Binding IsNumaSpanningToggleEnabled}"/>
                </ui:CardControl>

                <!-- 增强会话模式（主机侧许可） -->
                <ui:CardControl Margin="0,0,0,8" Padding="12">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon FontSize="22" Symbol="Remote20"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <TextBlock Text="{x:Static properties:Resources.Menu_EnhancedSessionMode}" FontSize="14" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding IsEnhancedSessionModeEnabled, Mode=TwoWay}"
                                     IsEnabled="{Binding IsEnhancedSessionModeToggleEnabled}"/>
                </ui:CardControl>

                <!-- 主机动态 MAC 地址池；上下限通过一次 WMI ModifyServiceSettings 原子提交。 -->
                <ui:CardControl Margin="0,0,0,8" Padding="12">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon FontSize="22" Symbol="VirtualNetwork20"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <TextBlock Text="{x:Static properties:Resources.Menu_DynamicMacAddressRange}" FontSize="14" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    </ui:CardControl.Header>
                    <Grid Width="620">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    MaxLength="17"
                                    FontFamily="Consolas"
                                    TextAlignment="Center"
                                    Text="{Binding MinimumDynamicMacAddress, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsDynamicMacRangeEnabled}"/>
                        <TextBlock Grid.Column="1"
                                   Margin="10,0"
                                   VerticalAlignment="Center"
                                   Text="→"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBox Grid.Column="2"
                                    MaxLength="17"
                                    FontFamily="Consolas"
                                    TextAlignment="Center"
                                    Text="{Binding MaximumDynamicMacAddress, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsDynamicMacRangeEnabled}"/>
                        <ui:Button Grid.Column="3"
                                   Margin="8,0,0,0"
                                   MinWidth="72"
                                   Content="{x:Static properties:Resources.Apply}"
                                   Command="{Binding ApplyDynamicMacRangeCommand}"/>
                    </Grid>
                </ui:CardControl>

                <!-- 新建虚拟机的主机默认位置 -->
                <ui:CardControl Margin="0,0,0,8" Padding="12">
                    <ui:CardControl.Icon>
                        <ui:FontIcon FontSize="22" FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xE838;"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <TextBlock Text="{x:Static properties:Resources.Menu_DefaultVirtualMachinePath}" FontSize="14" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    </ui:CardControl.Header>
                    <Grid Width="620">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding DefaultVirtualMachinePath}"
                                    IsReadOnly="True"
                                    ToolTip="{Binding DefaultVirtualMachinePath}"
                                    IsEnabled="{Binding AreDefaultPathsEnabled}"/>
                        <ui:Button Grid.Column="1"
                                   Margin="8,0,0,0"
                                   MinWidth="72"
                                   Content="{x:Static properties:Resources.Common_Select}"
                                   Command="{Binding BrowseDefaultVirtualMachinePathCommand}"
                                   IsEnabled="{Binding AreDefaultPathsEnabled}"/>
                    </Grid>
                </ui:CardControl>

                <!-- 新建虚拟硬盘的主机默认位置 -->
                <ui:CardControl Margin="0,0,0,8" Padding="12">
                    <ui:CardControl.Icon>
                        <ui:FontIcon FontSize="22" FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xE838;"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <TextBlock Text="{x:Static properties:Resources.Menu_DefaultVirtualHardDiskPath}" FontSize="14" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                    </ui:CardControl.Header>
                    <Grid Width="620">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding DefaultVirtualHardDiskPath}"
                                    IsReadOnly="True"
                                    ToolTip="{Binding DefaultVirtualHardDiskPath}"
                                    IsEnabled="{Binding AreDefaultPathsEnabled}"/>
                        <ui:Button Grid.Column="1"
                                   Margin="8,0,0,0"
                                   MinWidth="72"
                                   Content="{x:Static properties:Resources.Common_Select}"
                                   Command="{Binding BrowseDefaultVirtualHardDiskPathCommand}"
                                   IsEnabled="{Binding AreDefaultPathsEnabled}"/>
                    </Grid>
                </ui:CardControl>

                    </StackPanel>
                </TabItem>

                <TabItem Header="{x:Static properties:Resources.HostPage_AdvancedTab}"
                         Style="{StaticResource HostPageTabItemStyle}">
                    <StackPanel Margin="0,16,0,16">

                <!-- PCIe 策略 -->
                <ui:CardControl Margin="0,0,0,8" Padding="12">
                    <ui:CardControl.Icon>
                        <ui:FontIcon FontSize="22" FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xED56;"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static properties:Resources.Menu_UnlockHard}" FontSize="14" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{x:Static properties:Resources.Desc_UnlockHard}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding IsGpuStrategyEnabled, Mode=TwoWay}"
                                     IsEnabled="{Binding IsGpuStrategyToggleEnabled}"/>
                </ui:CardControl>

                <!-- 系统切换 (服务器版本切换) -->
                <ui:CardControl Margin="0,0,0,8" Padding="12">
                    <ui:CardControl.Icon>
                        <ui:FontIcon FontSize="22" FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xE8D7;"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static properties:Resources.Menu_SwitchServer}" FontSize="14" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{x:Static properties:Resources.Desc_SwitchServer}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding IsServerSystem, Mode=TwoWay}"
                                     IsEnabled="{Binding IsSystemSwitchEnabled}"/>
                </ui:CardControl>

                <!-- 主机原生 NVMe (Windows Server 2025 / Win11 24H2+)。不支持的系统上不隐藏，仅置灰开关。 -->
                <ui:CardControl Margin="0,0,0,8" Padding="12">
                    <ui:CardControl.Icon>
                        <ui:FontIcon FontSize="22" FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xEDA2;"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static properties:Resources.Menu_NativeNvme}" FontSize="14" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{x:Static properties:Resources.Desc_NativeNvme}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding IsNativeNvmeEnabled, Mode=TwoWay}"
                                     IsEnabled="{Binding IsNativeNvmeToggleEnabled}"/>
                </ui:CardControl>

                <!-- OpenHCL / IGVM 开发固件文件 -->
                <ui:CardControl Margin="0,0,0,8" Padding="12">
                    <ui:CardControl.Icon>
                        <ui:FontIcon FontSize="22" FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xF196;"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static properties:Resources.Menu_OpenHclFirmwareFile}" FontSize="14" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{x:Static properties:Resources.Desc_OpenHclFirmwareFile}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding IsOpenHclFirmwareFileEnabled, Mode=TwoWay}"/>
                </ui:CardControl>

                <!-- Windows Mount Manager 主机全局设置；控制新挂载卷是否自动获得盘符。 -->
                <ui:CardControl Margin="0,0,0,8" Padding="12">
                    <ui:CardControl.Icon>
                        <ui:FontIcon FontSize="22" FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xE756;"/>
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static properties:Resources.Menu_VolumeAutoMount}" FontSize="14" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{x:Static properties:Resources.Desc_VolumeAutoMount}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding IsVolumeAutoMountEnabled, Mode=TwoWay}"
                                     IsEnabled="{Binding IsVolumeAutoMountToggleEnabled}"/>
                </ui:CardControl>

                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </Grid>
</Page>
