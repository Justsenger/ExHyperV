<UserControl x:Class="ExHyperV.Views.GpuRepairDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:properties="clr-namespace:ExHyperV.Properties"
             mc:Ignorable="d"
             MinWidth="540">
    <StackPanel>
        <TextBlock x:Name="HeaderText"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"/>
        <TextBlock Text="{x:Static properties:Resources.GpuPv_Repair_Intro}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Margin="0,0,0,10"/>

        <StackPanel x:Name="ItemsHost"/>

        <TextBlock Text="{x:Static properties:Resources.GpuPv_Repair_BackupNote}"
                   TextWrapping="Wrap"
                   Opacity="0.7"
                   Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
